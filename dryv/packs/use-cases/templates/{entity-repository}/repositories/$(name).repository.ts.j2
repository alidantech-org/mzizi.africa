{%- macro dependency_path(slot) -%}
{%- for dependency in file.dependencies %}{% if dependency.slot == slot and dependency.target.id == schema.id %}{{ (dependency.path.prefixed or ('./' ~ dependency.path.relative)) | replace(".ts", "") }}{% endif %}{% endfor -%}
{%- endmacro -%}
{%- macro dependency_symbol(slot) -%}
{%- for dependency in file.dependencies %}{% if dependency.slot == slot and dependency.target.id == schema.id %}{{ dependency.symbol }}{% endif %}{% endfor -%}
{%- endmacro -%}
{%- set entity = dependency_symbol('schema.persistence') -%}
{#- A single-column unique index: the field is a natural key (looked up, not paged). -#}
{%- macro unique_field(field) -%}
{%- if schema.facets.storage is not none -%}
{%- for index in schema.facets.storage.indexes %}{% if index.unique and (index.fields | length) == 1 and index.fields[0].camel == field.name.camel %}yes{% endif %}{% endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- macro has_field(name) -%}
{%- for field in schema.fields %}{% if field.name.camel == name %}yes{% endif %}{% endfor -%}
{%- endmacro -%}
{#- "Country" for countryId, the field's own name otherwise. -#}
{%- macro suffix(field) -%}
{%- set stripped = (field.name.pascal ~ '#') | replace('Id#', '') | replace('#', '') -%}{{ stripped if stripped != '' else field.name.pascal }}
{%- endmacro -%}
{%- set soft = has_field('deletedAt') != '' -%}
{%- set constant = schema.name.constant -%}
{%- set name = schema.name.pascal -%}
import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { {% if soft %}IsNull, {% endif %}type Repository } from 'typeorm';
import { EntityRepository, type IUpdatableRepository } from '#/database/base/entity-repository.ts';
import { BaseQueryDto } from '#/database/base/base-query.dto.ts';
import type { IFindAllResponse } from '#/database/base/query.types.ts';
import { {{ entity }} } from '{{ dependency_path('schema.persistence') }}.ts';
import * as {{ name }} from '{{ dependency_path('schema.types') | replace('/' ~ schema.name.kebab ~ '.config', '/index') }}.ts';

/**
 * Repository of {{ schema.name.title }}: the base repository configured with the entity's
 * generated query fields. Regenerated by Dryv; the feature repositories build the contract's
 * named queries on top of it.
 */
@Injectable()
export class {{ file.symbol }}
  extends EntityRepository<
    {{ entity }},
    {{ name }}.Types.{{ name }}SortableField,
    {{ name }}.Types.{{ name }}EditableField,
    {{ name }}.Types.{{ name }}SelectableField,
    {{ name }}.Types.I{{ name }}Creatable
  >
{%- if has_field('id') != '' %}
  implements IUpdatableRepository<{{ entity }}, {{ name }}.Types.I{{ name }}Updatable>
{%- endif %}
{

  constructor(
    @InjectRepository({{ entity }})
    repository: Repository<{{ entity }}>,
  ) {
    super(repository, {{ name }}.Config.{{ constant }}_QUERY_OPTIONS);
  }
{%- if has_field('id') != '' %}

  /** Updates a row from only the editable fields of `data`. */
  async updateEditable(id: string, data: {{ name }}.Types.I{{ name }}Updatable): Promise<{{ entity }} | null> {
    const stamped = await this.stampUpdate(id, data);
    return stamped === null ? null : await this.update(id, stamped);
  }
{%- endif %}

{%- for field in schema.fields if field.value.is.property and field.related is none and not field.sensitive and field.array is none and unique_field(field) == '' and (field.relation is not none or field.value.is.enum) %}

  /** Find {{ schema.name.title | lower }} by {{ field.name.title | lower }}, paged by the shared query. */
  async findBy{{ suffix(field) }}(query: BaseQueryDto<{{ entity }}>, {{ field.name.camel }}: NonNullable<{{ entity }}['{{ field.name.camel }}']>): Promise<IFindAllResponse<{{ entity }}>> {
    return await this.findByQuery(query, { {{ field.name.camel }}{% if soft %}, deletedAt: IsNull(){% endif %} });
  }
{%- endfor %}
{%- for field in schema.fields if field.value.is.property and field.related is none and not field.sensitive and field.array is none and field.name.camel != 'id' and unique_field(field) != '' %}

  /** Find the {{ schema.name.title | lower }} with this {{ field.name.title | lower }} (unique). */
  async findBy{{ suffix(field) }}({{ field.name.camel }}: NonNullable<{{ entity }}['{{ field.name.camel }}']>): Promise<{{ entity }} | null> {
    return await this.findOne({ {{ field.name.camel }}{% if soft %}, deletedAt: IsNull(){% endif %} });
  }
{%- endfor %}
}
