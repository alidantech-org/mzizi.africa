{%- macro own(template) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.slot is none and dependency.template == template and dependency.target.id == operation.id -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro own_path(template) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.slot is none and dependency.template == template and dependency.target.id == operation.id -%}{{ (dependency.path.prefixed or ('./' ~ dependency.path.relative)) | replace(".ts", "") }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
