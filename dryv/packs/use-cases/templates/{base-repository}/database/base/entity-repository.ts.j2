/**
 * The contract every generated entity repository fulfils. Regenerated by Dryv; do not edit.
 *
 * `EntityRepository` extends the copied Defytickets `BaseRepository` and makes a child supply the
 * generated types and configs of its entity: its field classes, editable fields and relation
 * configs. A child that omits any of them does not compile.
 */
import { randomUUID } from "node:crypto";
import type { DeepPartial, EntityManager, ObjectLiteral, Repository, SelectQueryBuilder } from "typeorm";
import { BaseRepository } from "./base.repository.ts";

/** How an entity looks as a relation of another entity (the generated `<ENTITY>_AS_*_RELATION_CONFIG`). */
export interface RelationConfig<TSelectable extends string, TSortable extends string = never> {
  readonly relation: string;
  readonly selectableFields: readonly TSelectable[];
  readonly defaultSelectFields: readonly TSelectable[];
  readonly sortableFields?: readonly TSortable[];
  readonly defaultLimit?: number;
  readonly maxLimit?: number;
}

/**
 * The generated `<ENTITY>_QUERY_OPTIONS` of one entity, typed by that entity's own field unions.
 * A child repository passes this one object; nothing else configures a repository.
 */
export interface EntityQueryOptions<
  TSortable extends string,
  TEditable extends string,
  TSelectable extends string,
> {
  readonly searchableFields: readonly string[];
  readonly selectableFields: readonly TSelectable[];
  readonly defaultSelectFields: readonly TSelectable[];
  readonly sortableFields: readonly TSortable[];
  readonly filterFields: readonly string[];
  readonly dateRangeFields: readonly string[];
  readonly relationKeys: readonly string[];
  readonly editableFields: readonly TEditable[];
  readonly asOne: RelationConfig<TSelectable>;
  readonly asMany: RelationConfig<TSelectable, TSortable>;
}

/** What every entity repository offers. */
export interface IEntityRepository<TEntity extends ObjectLiteral, TCreatable extends object> {
  query(alias: string, manager?: EntityManager): SelectQueryBuilder<TEntity>;
  createEditable(data: TCreatable): Promise<TEntity>;
}

/** Implemented by the repositories of entities that have an `id` to update by. */
export interface IUpdatableRepository<TEntity extends ObjectLiteral, TUpdatable extends object> {
  updateEditable(id: string, data: TUpdatable): Promise<TEntity | null>;
}

export abstract class EntityRepository<
    TEntity extends ObjectLiteral,
    TSortable extends string,
    TEditable extends string,
    TSelectable extends string,
    TCreatable extends object,
  >
  extends BaseRepository<TEntity>
  implements IEntityRepository<TEntity, TCreatable>
{
  constructor(
    repository: Repository<TEntity>,
    readonly queryOptions: EntityQueryOptions<TSortable, TEditable, TSelectable>,
  ) {
    // The one place the generated, interface-keyed lists become the entity-keyed config the
    // base repository takes.
    super(repository, {
      searchableFields: [...queryOptions.searchableFields] as (keyof TEntity)[],
      selectableFields: [...queryOptions.selectableFields] as (keyof TEntity)[],
      defaultSelectFields: [...queryOptions.defaultSelectFields] as (keyof TEntity)[],
      relationKeys: [...queryOptions.relationKeys],
      buildWhereOptions: {
        searchableFields: [...queryOptions.searchableFields] as (keyof TEntity)[],
        filterFields: [...queryOptions.filterFields] as (keyof TEntity)[],
        dateRangeFields: [...queryOptions.dateRangeFields] as (keyof TEntity)[],
      },
    });
  }

  /** A query builder over this entity for the feature repositories' named queries. */
  query(alias: string, manager?: EntityManager): SelectQueryBuilder<TEntity> {
    return this.createQueryBuilder(alias, manager);
  }

  /**
   * Creates a row from only the editable fields of `data`. The entity declares no database
   * defaults for its system fields, so the id, timestamps and version are set here.
   */
  createEditable(data: TCreatable): Promise<TEntity> {
    const row = this.pickEditable(data) as Record<string, unknown>;
    const now = new Date();
    if (this.hasColumn("id") && row.id === undefined) row.id = randomUUID();
    if (this.hasColumn("createdAt")) row.createdAt = now;
    if (this.hasColumn("updatedAt")) row.updatedAt = now;
    if (this.hasColumn("version")) row.version = 1;
    return this.create(row as DeepPartial<TEntity>);
  }

  /**
   * The editable fields of `data` with the row's new `updatedAt` and `version`, or null when
   * no row has this id.
   */
  protected async stampUpdate(id: string, data: object): Promise<DeepPartial<TEntity> | null> {
    const existing = await this.findById(id);
    if (!existing) return null;
    const row = this.pickEditable(data) as Record<string, unknown>;
    if (this.hasColumn("updatedAt")) row.updatedAt = new Date();
    if (this.hasColumn("version")) row.version = Number(existing.version ?? 0) + 1;
    return row as DeepPartial<TEntity>;
  }

  private hasColumn(property: string): boolean {
    return this.repository.metadata.findColumnWithPropertyName(property) !== undefined;
  }

  /** The editable fields of `data` that are present. */
  protected pickEditable(data: object): DeepPartial<TEntity> {
    const source = data as Record<string, unknown>;
    const picked: Record<string, unknown> = {};
    for (const field of this.queryOptions.editableFields) {
      if (source[field] !== undefined) picked[field] = source[field];
    }
    return picked as DeepPartial<TEntity>;
  }
}
