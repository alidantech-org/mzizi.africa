import { type IFindAllOptions } from './query.types.ts';
import { IsOptional, IsString, IsNumber, IsBoolean, IsDateString, IsArray, IsIn, IsEnum, IsDate } from 'class-validator';
import { ESortOrder } from './sort-order.enums.ts';
import { Transform } from 'class-transformer';

export function ToArray() {
  return Transform(({ value }) => {
    if (typeof value === 'string') return value.split(',').map((v) => v.trim());
    return value;
  });
}

export function ToUpperCase() {
  return Transform(({ value }) => {
    if (Array.isArray(value)) {
      return value.map((v) => (typeof v === 'string' ? v.toUpperCase() : v));
    }
    return typeof value === 'string' ? value.toUpperCase() : value;
  });
}

export function ToBoolean() {
  return Transform(({ value, obj, key }) => {
    const rawValue = obj && key in obj ? obj[key] : value;
    if (rawValue === 'true' || rawValue === '1' || rawValue === true) return true;
    if (rawValue === 'false' || rawValue === '0' || rawValue === false) return false;
    return rawValue;
  });
}

/**
 * Base Query DTO for pagination and filtering
 */
export class BaseQueryDto<T> implements IFindAllOptions<T> {
  /** Page number, 1-indexed */
  @IsOptional()
  @IsNumber()
  page?: number;

  /** Number of records per page */
  @IsOptional()
  @IsNumber()
  limit?: number;

  /** Relations to eager-load */
  @IsOptional()
  @IsString({ each: true })
  relations?: (keyof T)[];

  /** Fields to select - comma-separated string that will be transformed to array */
  @IsOptional()
  @IsArray()
  select?: (keyof T)[];

  /** Field(s) to sort by - can be single field or comma-separated fields */
  @IsOptional()
  @ToArray()
  @IsArray()
  sortBy?: keyof T | (keyof T)[];

  /** Sort direction(s) - array matching sortBy fields, supports comma-separated or array */
  @IsOptional()
  @ToArray()
  @IsArray()
  @ToUpperCase()
  @IsEnum(ESortOrder, { each: true })
  sortOrder?: ESortOrder[];

  /** Include soft-deleted records */
  @IsOptional()
  @ToBoolean()
  @IsBoolean()
  withDeleted?: boolean;

  /** Search term for filtering across multiple fields */
  @IsOptional()
  @IsString()
  search?: string;

  /** Filter by createdAt >= createdAtFrom */
  @IsOptional()
  @IsDate()
  createdAtFrom?: Date;

  /** Filter by createdAt <= createdAtTo */
  @IsOptional()
  @IsDate()
  createdAtTo?: Date;

  /** Filter by updatedAt >= updatedAtFrom */
  @IsOptional()
  @IsDate()
  updatedAtFrom?: Date;

  /** Filter by updatedAt <= updatedAtTo */
  @IsOptional()
  @IsDate()
  updatedAtTo?: Date;
}
