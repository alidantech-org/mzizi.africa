/**
 * Sort Order Enums
 *
 * Centralized sort order values used across the application
 * to ensure consistency and avoid hardcoded strings.
 */

export enum ESortOrder {
  ASC = 'ASC',
  DESC = 'DESC'
}

/**
 * Type alias for sort order to ensure type safety
 */
export type SortOrder = ESortOrder.ASC | ESortOrder.DESC;

/**
 * Default sort order for most queries
 */
export const DEFAULT_SORT_ORDER = ESortOrder.DESC;

/**
 * Sort order options for validation
 */
export const SORT_ORDER_OPTIONS = Object.values(ESortOrder) as readonly SortOrder[];
