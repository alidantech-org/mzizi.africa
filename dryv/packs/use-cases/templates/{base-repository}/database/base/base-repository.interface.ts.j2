import { type DeepPartial, type FindOptionsWhere } from 'typeorm';
import { type IFindAllOptions } from './query.types.ts';

export interface IBaseRepository<T> {
  /** Find a single record by its UUID */
  findById(id: string, relations?: readonly (keyof T)[]): Promise<T | null>;

  /** Find a single record by custom criteria */
  findOne(where: FindOptionsWhere<T>, relations?: readonly (keyof T)[]): Promise<T | null>;

  /** Create and save a new record */
  create(data: DeepPartial<T>): Promise<T>;

  /** Update an existing record by ID */
  update(id: string, data: DeepPartial<T>): Promise<T | null>;

  /** Perform a soft delete (sets deletedAt timestamp) */
  softDelete(id: string): Promise<boolean>;

  /** Hard delete a record by ID */
  delete(id: string): Promise<boolean>;

  /** Restore a soft-deleted record by ID */
  restore(id: string): Promise<boolean>;

  /** Check if a record exists based on criteria */
  exists(where: FindOptionsWhere<T>): Promise<boolean>;

  /** Count records matching criteria */
  count(where: FindOptionsWhere<T>): Promise<number>;

  /** Increment a numeric field by a value */
  increment(where: FindOptionsWhere<T>, propertyPath: keyof T, value: number): Promise<void>;

  /** Decrement a numeric field by a value */
  decrement(where: FindOptionsWhere<T>, propertyPath: keyof T, value: number): Promise<void>;
}
