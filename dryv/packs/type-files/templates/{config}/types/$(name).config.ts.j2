{#- The generated symbol of another planned file of the given template, for a subject. -#}
{%- macro dep(id, template) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == id and dependency.template == template -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{#- Relative path (without .ts) to another planned file of the given template, for a subject. -#}
{%- macro dep_path(id, template) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == id and dependency.template == template -%}{{ (dependency.path.prefixed or ('./' ~ dependency.path.relative)) | replace(".ts", "") }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{#- Fields the shared B.IBase interface already declares. -#}
{%- macro is_base(field) -%}
{%- if field.name.camel in ['id', 'createdAt', 'updatedAt', 'deletedAt', 'version'] -%}yes{%- endif -%}
{%- endmacro -%}

{#- "yes" for a temporal field that can be filtered by range (`between`). -#}
{%- macro is_date_range(field) -%}
{%- if field.value.is.property and field.value.is.temporal and field.query is not none -%}
{%- for operator in field.query.filter -%}{%- if operator == 'between' -%}yes{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- endmacro -%}

{%- macro is_filterable(field) -%}
{%- if field.query is not none and is_date_range(field) == '' -%}{%- for operator in field.query.filter -%}{%- if loop.first -%}yes{%- endif -%}{%- endfor -%}{%- endif -%}
{%- endmacro -%}

{%- macro is_selectable(field) -%}
{%- if field.related is none and (field.query is none or field.query.select != 'never') -%}yes{%- endif -%}
{%- endmacro -%}

{%- macro has_default_select() -%}
{%- for field in schema.fields -%}{%- if field.query is not none and field.query.select == 'default' -%}yes{%- endif -%}{%- endfor -%}
{%- endmacro -%}

{%- macro is_default_select(field) -%}
{%- if has_default_select() -%}{%- if field.query is not none and field.query.select == 'default' -%}yes{%- endif -%}
{%- elif is_selectable(field) -%}yes{%- endif -%}
{%- endmacro -%}

{#- Navigation name and target link of a relation, for fields that relate to another entity. -#}
{#- A relation is named after its target (appId -> app), as the TypeORM pack does; a second
    relation to the same target is named after its field instead (ownerId -> ownerIdRelation). -#}
{%- macro relation_name(field, position) -%}
{%- if field.relation is not none -%}{% if target_seen(field.relation.target.schema.id, position) %}{{ field.name.camel }}Relation{% else %}{{ field.relation.target.schema.name.camel }}{% endif %}{%- elif field.related is not none -%}{{ field.name.camel }}{%- endif -%}
{%- endmacro -%}

{#- "yes" when an earlier field already relates to the same target (import it once). -#}
{%- macro target_seen(target, position) -%}
{%- for other in schema.fields -%}{%- if loop.index < position and relation_target(other) == target -%}yes{%- endif -%}{%- endfor -%}
{%- endmacro -%}

{#- Module alias for a related entity: IApp -> App. -#}
{%- macro alias(target) -%}{{ dep(target, 'types')[1:] }}{%- endmacro -%}

{%- macro relation_target(field) -%}
{%- if field.relation is not none -%}{{ field.relation.target.schema.id }}{%- elif field.related is not none -%}{{ field.related.via.schema.id }}{%- endif -%}
{%- endmacro -%}

{%- macro list(kind) -%}
{%- for field in schema.fields -%}
{%- if (kind == 'sortable' and field.query is not none and field.query.sort)
    or (kind == 'searchable' and field.query is not none and field.query.search)
    or (kind == 'filterable' and is_filterable(field))
    or (kind == 'dateRange' and is_date_range(field))
    or (kind == 'selectable' and is_selectable(field))
    or (kind == 'defaultSelect' and is_default_select(field))
    or (kind == 'editable' and field.mutation is none and field.related is none and is_base(field) == '') -%}
'{{ field.name.camel }}', {% endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- set name = schema.name.pascal -%}
{%- set constant = schema.name.constant -%}
// ----------------------------------
// SHARED CONFIG TYPES
// ----------------------------------

import * as Q from '{{ (file.path.import_base ~ 'common/types/query') if file.path.import_base else '../../common/types/query' }}';
import { ERelationType } from '{{ (file.path.import_base ~ 'common/types/enums') if file.path.import_base else '../../common/types/enums' }}';

// ----------------------------------
// RELATED ENTITY CONFIGS
// ----------------------------------
{%- for field in schema.fields %}
{%- set target = relation_target(field) %}
{%- if target and target != schema.id and dep(target, 'config') and target_seen(target, loop.index) == '' %}
import * as {{ alias(target) }}Config from '{{ dep_path(target, 'config') }}';
{%- endif %}
{%- endfor %}

// ----------------------------------
// LOCAL TYPES
// ----------------------------------

import type {
  I{{ name }},
  {{ name }}Key,
  {{ name }}RelationKey,
  {{ name }}SortableField,
  {{ name }}FilterableField,
  {{ name }}DateRangeField,
  {{ name }}SelectableField,
  I{{ name }}AsOneRelationConfig,
  I{{ name }}AsManyRelationConfig
} from './{{ schema.name.kebab }}.types';

// ----------------------------------
// RELATION KEYS
// ----------------------------------

export const {{ constant }}_RELATION_KEYS = [
{%- for field in schema.fields %}{% set target = relation_target(field) %}{% if target and dep(target, 'types') %}'{{ relation_name(field, loop.index) }}', {% endif %}{% endfor -%}
] as const satisfies readonly {{ name }}Key[];

// ----------------------------------
// QUERY FIELD CONFIG
// ----------------------------------

export const {{ constant }}_SORTABLE_FIELDS = [{{ list('sortable') }}] as const satisfies readonly {{ name }}Key[];

export const {{ constant }}_SEARCHABLE_FIELDS = [{{ list('searchable') }}] as const satisfies readonly {{ name }}Key[];

export const {{ constant }}_FILTERABLE_FIELDS = [{{ list('filterable') }}] as const satisfies readonly {{ name }}Key[];

export const {{ constant }}_DATE_RANGE_FIELDS = [{{ list('dateRange') }}] as const satisfies readonly {{ name }}Key[];

// ----------------------------------
// SELECT FIELD CONFIG
// ----------------------------------

export const {{ constant }}_SELECTABLE_FIELDS = [{{ list('selectable') }}] as const satisfies readonly {{ name }}Key[];

export const {{ constant }}_DEFAULT_SELECT_FIELDS = [{{ list('defaultSelect') }}] as const satisfies readonly {{ name }}SelectableField[];

// ----------------------------------
// EDITABLE FIELD CONFIG
// ----------------------------------

export const {{ constant }}_EDITABLE_FIELDS = [{{ list('editable') }}] as const satisfies readonly {{ name }}Key[];

// ----------------------------------
// RELATION CONFIGS
// ----------------------------------

export const {{ constant }}_AS_ONE_RELATION_CONFIG = {
  relation: '{{ schema.name.camel }}',
  type: ERelationType.One,
  selectableFields: {{ constant }}_SELECTABLE_FIELDS,
  defaultSelectFields: {{ constant }}_DEFAULT_SELECT_FIELDS
} as const satisfies I{{ name }}AsOneRelationConfig;

export const {{ constant }}_AS_MANY_RELATION_CONFIG = {
  relation: '{{ schema.name.camel }}s',
  type: ERelationType.Many,
  selectableFields: {{ constant }}_SELECTABLE_FIELDS,
  defaultSelectFields: {{ constant }}_DEFAULT_SELECT_FIELDS,
  sortableFields: {{ constant }}_SORTABLE_FIELDS,
  defaultLimit: 10,
  maxLimit: 50
} as const satisfies I{{ name }}AsManyRelationConfig;

// ----------------------------------
// RELATION QUERY OPTIONS
// ----------------------------------

export const {{ constant }}_ONE_RELATION_QUERY_OPTIONS = [
{%- for field in schema.fields %}{% set target = relation_target(field) %}{% if field.relation is not none and target != schema.id and dep(target, 'config') %}
  Q.createRelationKeyMapper<{{ name }}RelationKey>().one({{ alias(target) }}Config.{{ dep(target, 'config') | replace('_QUERY_OPTIONS', '_AS_ONE_RELATION_CONFIG') }}, '{{ relation_name(field, loop.index) }}'),
{%- endif %}{% endfor %}
] as const;

export const {{ constant }}_MANY_RELATION_QUERY_OPTIONS = [
{%- for field in schema.fields %}{% set target = relation_target(field) %}{% if field.related is not none and target != schema.id and dep(target, 'config') %}
  Q.createRelationKeyMapper<{{ name }}RelationKey>().many({{ alias(target) }}Config.{{ dep(target, 'config') | replace('_QUERY_OPTIONS', '_AS_MANY_RELATION_CONFIG') }}, '{{ relation_name(field, loop.index) }}'),
{%- endif %}{% endfor %}
] as const;

// ----------------------------------
// ENTITY QUERY OPTIONS
// ----------------------------------

export const {{ file.symbol }} = {
  searchableFields: {{ constant }}_SEARCHABLE_FIELDS,
  selectableFields: {{ constant }}_SELECTABLE_FIELDS,
  defaultSelectFields: {{ constant }}_DEFAULT_SELECT_FIELDS,
  sortableFields: {{ constant }}_SORTABLE_FIELDS,
  filterFields: {{ constant }}_FILTERABLE_FIELDS,
  dateRangeFields: {{ constant }}_DATE_RANGE_FIELDS,
  oneRelations: {{ constant }}_ONE_RELATION_QUERY_OPTIONS,
  manyRelations: {{ constant }}_MANY_RELATION_QUERY_OPTIONS
} as const satisfies Q.IEntityQueryOptions<
  I{{ name }},
  {{ name }}SortableField,
  {{ name }}SelectableField,
  {{ name }}FilterableField,
  {{ name }}DateRangeField,
  {{ name }}RelationKey,
  typeof {{ constant }}_ONE_RELATION_QUERY_OPTIONS,
  typeof {{ constant }}_MANY_RELATION_QUERY_OPTIONS
>;
