{#- PostgreSQL snapshot for one database. Everything is derived from the contracts: nothing here
    is hand-written schema. Rejections use the `{}['message']` idiom (StrictUndefined carries the
    message into the generation error). -#}
{%- set placement = namespace(names=[]) -%}
{%- for schema in schemas -%}
{%- if schema.facets.storage.store != pack.store -%}{{ {}['schema store differs from selected pack store: ' ~ schema.id] }}{%- endif -%}
{%- if schema.facets.storage.namespace not in placement.names -%}{%- set placement.names = placement.names + [schema.facets.storage.namespace] -%}{%- endif -%}
{%- endfor -%}
{%- set database = pack.connection.database -%}

{%- macro table_of(schema) -%}
{%- set storage = schema.facets.storage -%}
{%- if storage is not none and storage.name is not none -%}{{ storage.name }}{%- else -%}{{ schema.name.snake }}{%- endif -%}
{%- endmacro -%}

{%- macro namespace_of(schema) -%}
{%- set storage = schema.facets.storage -%}
{%- if storage is none or storage.namespace is none -%}{{ {}['entity ' ~ schema.id ~ ' has no storage namespace; set facets.storage.namespace'] }}{%- endif -%}
{{ storage.namespace }}
{%- endmacro -%}

{%- macro lookup_namespace(id) -%}
{%- for candidate in schemas -%}{%- if candidate.id == id -%}{{ namespace_of(candidate) }}{%- endif -%}{%- endfor -%}
{%- endmacro -%}

{%- macro lookup_table(id) -%}
{%- for candidate in schemas -%}{%- if candidate.id == id -%}"{{ namespace_of(candidate) }}"."{{ table_of(candidate) }}"{%- endif -%}{%- endfor -%}
{%- endmacro -%}

{%- macro is_primary(storage, field) -%}
{%- if storage is not none -%}{%- for key in storage.primary_key -%}{%- if key.raw == field.name.raw -%}yes{%- endif -%}{%- endfor -%}{%- endif -%}
{%- endmacro -%}

{%- macro lifecycle(value) -%}
{%- if value == 'cascade' -%}CASCADE{%- elif value == 'restrict' -%}RESTRICT{%- elif value == 'detach' -%}SET NULL{%- elif value is none -%}NO ACTION{%- else -%}{{ {}['unsupported relation lifecycle ' ~ value] }}{%- endif -%}
{%- endmacro -%}

{#- PostgreSQL type of a stored field. -#}
{%- macro sql_type(schema, field) -%}{{ element_type(schema, field) | trim }}{% if field.array is not none %}[]{% endif %}{%- endmacro -%}

{%- macro element_type(schema, field) -%}
{%- set value = field.value -%}
{%- if value.is.geometry -%}
  {%- set spatial = value.geometry -%}
  geometry({{ 'geometry' if spatial.shape == 'any' else spatial.shape }}{{ (spatial.dimensions | string)[2:] }}, {{ spatial.srid }})
{%- elif not value.is.property -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': nested schema values have no relational mapping; model a relation instead'] }}
{%- elif value.is.primitive -%}
  {%- set primitive = value.property.primitive -%}
  {%- if primitive.is.string and primitive.is.uuid -%}uuid
  {%- elif primitive.is.string and primitive.constraints.length is not none and primitive.constraints.length.has_max -%}varchar({{ primitive.constraints.length.max }})
  {%- elif primitive.is.string and primitive.constraints.length is not none and primitive.constraints.length.has_exact -%}char({{ primitive.constraints.length.exact }})
  {%- elif primitive.is.string and primitive.format == 'json' -%}jsonb
  {%- elif primitive.is.string -%}text
  {%- elif primitive.is.boolean -%}boolean
  {%- elif primitive.money is not none and primitive.money.minor_units -%}bigint
  {%- elif primitive.is.integer and primitive.constraints.bits == 64 -%}bigint
  {%- elif primitive.is.integer -%}integer
  {%- elif primitive.is.decimal -%}numeric({{ primitive.constraints.precision }}, {{ primitive.constraints.scale }})
  {%- else -%}double precision
  {%- endif -%}
{%- elif value.is.enum -%}text
{%- elif value.is.temporal -%}
  {%- set temporal = value.property.temporal -%}
  {%- if temporal.is.date -%}date
  {%- elif temporal.is.time -%}time
  {%- elif temporal.is.duration or temporal.is.interval -%}interval
  {%- else -%}timestamptz
  {%- endif -%}
{%- else -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': property kind has no PostgreSQL mapping (record, composite, union, tuple, generic and literal are unsupported)'] }}
{%- endif -%}
{%- endmacro -%}

{#- Scope columns in an overlap constraint: nullable columns compare null as equal by coalescing to a
    neutral sentinel of the column type. -#}
{%- macro null_sentinel(schema, field, type) -%}
{%- if type == 'uuid' -%}'00000000-0000-0000-0000-000000000000'::uuid
{%- elif type == 'text' or type[:7] == 'varchar' or type[:4] == 'char' -%}''
{%- elif type == 'integer' or type == 'bigint' -%}-1
{%- else -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': nullable scope column of type ' ~ type ~ ' has no neutral value for an overlap constraint'] }}
{%- endif -%}
{%- endmacro -%}

{%- macro range_function(schema, field, type) -%}
{%- if type == 'date' -%}daterange
{%- elif type == 'timestamptz' -%}tstzrange
{%- else -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': overlap windows must be date or timestamp fields, not ' ~ type] }}
{%- endif -%}
{%- endmacro -%}

{#- PostgreSQL literals retain text exactly; JSON quote substitution is not SQL escaping. -#}
{%- macro sql_literal(value) -%}
{%- if value is none -%}NULL
{%- elif value is string -%}'{{ value | replace("'", "''") }}'
{%- elif value is boolean -%}{{ 'TRUE' if value else 'FALSE' }}
{%- elif value is number -%}{{ value }}
{%- else -%}{{ {}['structured literal requires an explicit PostgreSQL mapping'] }}
{%- endif -%}
{%- endmacro -%}

{%- macro partition_literal(value) -%}
{%- if value.kind == 'string' -%}'{{ value.text | replace("'", "''") }}'
{%- elif value.kind == 'null' -%}NULL
{%- elif value.kind == 'minvalue' -%}MINVALUE
{%- elif value.kind == 'maxvalue' -%}MAXVALUE
{%- elif value.kind == 'boolean' -%}{{ 'TRUE' if value.text == 'True' or value.text == 'true' else 'FALSE' }}
{%- else -%}{{ value.text }}
{%- endif -%}
{%- endmacro -%}

{%- macro comment_text(text) -%}E'{{ text | replace('\\', '\\\\') | replace("'", "''") }}'{%- endmacro -%}

{#- A relation that is also part of a composite reference to the same target is enforced by that composite key
    (required where the target is partitioned and its key includes the partition key). -#}
{%- macro covered_by_composite(schema, field) -%}
{%- set hit = namespace(found=false) -%}
{%- for constraint in schema.facets.storage.constraints -%}
{%- if constraint.kind == 'references' and constraint.target.id == field.relation.target.schema.id -%}
{%- for item in constraint.fields -%}{%- if item.raw == field.name.raw -%}{%- set hit.found = true -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{{- 'yes' if hit.found else '' -}}
{%- endmacro -%}

{%- macro spatial_function(name) -%}
{%- if name == 'envelope' -%}ST_Envelope{%- elif name == 'centroid' -%}ST_Centroid{%- elif name == 'area' -%}ST_Area{%- endif -%}
{%- endmacro -%}

{%- macro scheme_code(field, schema) -%}
