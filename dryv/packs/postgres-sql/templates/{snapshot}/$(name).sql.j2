{%- elif constraint.kind == 'references' %}
{%- for candidate in schemas %}{% if candidate.id == constraint.target.id %}
{%- set tcols = namespace(items=[]) -%}{%- for item in constraint.target_fields %}{% set tcols.items = tcols.items + [item.snake] %}{% endfor -%}
{%- set target_key = ("uq_" ~ table_of(candidate) ~ "__" ~ (tcols.items | join("_")) ~ "_key")[:63] -%}
{%- if (namespace_of(candidate) ~ '.' ~ target_key) not in emitted.keys %}
{%- set emitted.keys = emitted.keys + [namespace_of(candidate) ~ '.' ~ target_key] %}
ALTER TABLE {{ lookup_table(candidate.id) }} ADD CONSTRAINT "{{ target_key }}" UNIQUE ({% for item in constraint.target_fields %}"{{ item.snake }}"{% if not loop.last %}, {% endif %}{% endfor %});
{%- endif %}
ALTER TABLE "{{ ns }}"."{{ table_of(schema) }}" ADD CONSTRAINT "fk_{{ table_of(schema) }}__{{ constraint.name.snake }}" FOREIGN KEY ({% for item in constraint.fields %}"{{ item.snake }}"{% if not loop.last %}, {% endif %}{% endfor %}) REFERENCES {{ lookup_table(candidate.id) }} ({% for item in constraint.target_fields %}"{{ item.snake }}"{% if not loop.last %}, {% endif %}{% endfor %});
{%- endif %}{% endfor %}
{%- elif constraint.kind == 'same-as' %}
{%- if pk | length != 1 %}{{ {}[schema.id ~ ': same-as constraint ' ~ constraint.name.raw ~ ' needs a single-column primary key'] }}{% endif %}
ALTER TABLE "{{ ns }}"."{{ table_of(schema) }}" ADD CONSTRAINT "uq_{{ table_of(schema) }}__{{ constraint.name.snake }}" UNIQUE ("{{ pk[0].snake }}"{% for item in constraint.match %}, "{{ item.snake }}"{% endfor %});
ALTER TABLE "{{ ns }}"."{{ table_of(schema) }}" ADD CONSTRAINT "fk_{{ table_of(schema) }}__{{ constraint.name.snake }}" FOREIGN KEY ("{{ constraint.field.snake }}"{% for item in constraint.match %}, "{{ item.snake }}"{% endfor %}) REFERENCES "{{ ns }}"."{{ table_of(schema) }}" ("{{ pk[0].snake }}"{% for item in constraint.match %}, "{{ item.snake }}"{% endfor %});
{%- elif constraint.kind == 'no-overlap' %}
{%- set elements = namespace(items=[]) %}
{%- for scope_name in constraint.scope %}{% for field in schema.fields %}{% if field.name.raw == scope_name.raw %}
{%- set type = sql_type(schema, field) | trim %}
{%- if field.optional or field.nullable %}{% set elements.items = elements.items + ['(coalesce("' ~ field.name.snake ~ '", ' ~ null_sentinel(schema, field, type) ~ ')) WITH ='] %}
{%- else %}{% set elements.items = elements.items + ['"' ~ field.name.snake ~ '" WITH ='] %}{% endif %}
{%- endif %}{% endfor %}{% endfor %}
{%- for field in schema.fields %}{% if field.name.raw == constraint.start.raw %}
{%- set elements.items = elements.items + [(range_function(schema, field, sql_type(schema, field) | trim) | trim) ~ '("' ~ constraint.start.snake ~ '", "' ~ constraint.end.snake ~ '", \'[)\') WITH &&'] %}
{%- endif %}{% endfor %}
ALTER TABLE "{{ ns }}"."{{ table_of(schema) }}" ADD CONSTRAINT "ex_{{ table_of(schema) }}__{{ constraint.name.snake }}" EXCLUDE USING gist ({{ elements.items | join(', ') }});
{%- else %}{{ {}['unsupported SQL storage constraint: ' ~ constraint.kind] }}
{%- endif %}
{%- endfor %}
{%- endif %}{% endfor %}
{%- endfor %}

{#- Scheme-constrained links retain their ordinary foreign key. The additional checks cover both
    writes through the link and changes to the referenced classification identity. -#}
{%- for schema in schemas %}
{%- set ns = namespace_of(schema) %}
{%- for field in schema.fields %}
{%- set code = scheme_code(field, schema) | trim %}
{%- if code %}
{%- if field.relation is none or field.relation.enforcement != 'foreign-key' %}
{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': scheme tags require a foreign key'] }}
{%- elif field.relation.target.schema.name.raw != 'Terms' or lookup_namespace(field.relation.target.schema.id) != 'vocabulary' %}
{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': scheme tags require a link to vocabulary.Terms'] }}
{%- endif %}
{%- set source_table = '"' ~ ns ~ '"."' ~ table_of(schema) ~ '"' %}
{%- set value_table = lookup_table(field.relation.target.schema.id) %}
{%- set key = field.relation.target.field.snake %}
{%- set trigger = ('scheme_' ~ table_of(schema) ~ '_' ~ field.name.snake) %}
CREATE FUNCTION "{{ ns }}"."{{ trigger }}"() RETURNS trigger LANGUAGE plpgsql AS $scheme$
BEGIN
  IF NEW."{{ field.name.snake }}" IS NOT NULL AND NOT EXISTS (
    SELECT 1
    FROM {{ value_table }} v
    JOIN "vocabulary"."schemes" s ON s."id" = v."scheme_id"
    WHERE v."{{ key }}" = NEW."{{ field.name.snake }}" AND s."code" = {{ sql_literal(code) }}
    FOR SHARE OF v, s
  ) THEN
    RAISE EXCEPTION 'referenced value belongs to a different scheme' USING ERRCODE = '23514';
  END IF;
  RETURN NEW;
END;
$scheme$;
CREATE TRIGGER "{{ trigger }}" BEFORE INSERT OR UPDATE OF "{{ field.name.snake }}"
ON {{ source_table }} FOR EACH ROW EXECUTE FUNCTION "{{ ns }}"."{{ trigger }}"();
CREATE FUNCTION "{{ ns }}"."{{ trigger }}_membership"() RETURNS trigger LANGUAGE plpgsql AS $scheme$
BEGIN
  IF NEW."scheme_id" IS DISTINCT FROM OLD."scheme_id" AND EXISTS (
    SELECT 1 FROM {{ source_table }} t WHERE t."{{ field.name.snake }}" = OLD."{{ key }}"
  ) THEN
    RAISE EXCEPTION 'cannot move a value used by a scheme-constrained link' USING ERRCODE = '23514';
  END IF;
  RETURN NEW;
END;
$scheme$;
CREATE TRIGGER "{{ ns }}_{{ trigger }}_membership" BEFORE UPDATE OF "scheme_id"
ON {{ value_table }} FOR EACH ROW EXECUTE FUNCTION "{{ ns }}"."{{ trigger }}_membership"();
CREATE FUNCTION "{{ ns }}"."{{ trigger }}_code"() RETURNS trigger LANGUAGE plpgsql AS $scheme$
BEGIN
  IF OLD."code" = {{ sql_literal(code) }} AND NEW."code" IS DISTINCT FROM OLD."code" AND EXISTS (
    SELECT 1 FROM {{ source_table }} t
    JOIN {{ value_table }} v ON v."{{ key }}" = t."{{ field.name.snake }}"
    WHERE v."scheme_id" = OLD."id"
  ) THEN
    RAISE EXCEPTION 'cannot rename a scheme used by a scheme-constrained link' USING ERRCODE = '23514';
  END IF;
  RETURN NEW;
END;
$scheme$;
CREATE TRIGGER "{{ ns }}_{{ trigger }}_code" BEFORE UPDATE OF "code"
ON "vocabulary"."schemes" FOR EACH ROW EXECUTE FUNCTION "{{ ns }}"."{{ trigger }}_code"();
{%- endif %}
{%- endfor %}
{%- for view in schema.views %}
CREATE{% if view.materialized %} MATERIALIZED{% endif %} VIEW "{{ view.namespace }}"."{{ view.name.raw }}" AS
SELECT {% for column in view.columns %}"{{ column.field.snake }}" AS "{{ column.name.snake }}"{% if not loop.last %}, {% endif %}{% endfor %}
FROM "{{ ns }}"."{{ table_of(schema) }}"{% if view.where %} WHERE "{{ view.where.field.snake }}" IS {% if not view.where.is_null %}NOT {% endif %}NULL{% endif %};
{%- endfor %}
{%- endfor %}

{#- Descriptions become SQL comments: tables and columns of every selected entity. -#}
{%- for schema in schemas %}
{%- set ns = namespace_of(schema) %}
{%- if schema.description %}
COMMENT ON TABLE "{{ ns }}"."{{ table_of(schema) }}" IS {{ comment_text(schema.description) }};
{%- endif %}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown and field.description %}
COMMENT ON COLUMN "{{ ns }}"."{{ table_of(schema) }}"."{{ field.name.snake }}" IS {{ comment_text(field.description) }};
{%- endif %}{% endfor %}
{%- endfor %}
