{%- set trigger = ('scheme_' ~ table_of(schema) ~ '_' ~ field.name.snake) %}
CREATE FUNCTION "{{ ns }}"."{{ trigger }}"() RETURNS trigger LANGUAGE plpgsql AS $scheme$
BEGIN
  IF NEW."{{ field.name.snake }}" IS NOT NULL AND NOT EXISTS (
    SELECT 1
    FROM {{ value_table }} v
    JOIN "vocabulary"."schemes" s ON s."id" = v."scheme_id"
    WHERE v."{{ key }}" = NEW."{{ field.name.snake }}" AND s."code" = {{ sql_literal(code) }}
    FOR SHARE OF v, s
  ) THEN
    RAISE EXCEPTION 'referenced value belongs to a different scheme' USING ERRCODE = '23514';
  END IF;
  RETURN NEW;
END;
$scheme$;
CREATE TRIGGER "{{ trigger }}" BEFORE INSERT OR UPDATE OF "{{ field.name.snake }}"
ON {{ source_table }} FOR EACH ROW EXECUTE FUNCTION "{{ ns }}"."{{ trigger }}"();
CREATE FUNCTION "{{ ns }}"."{{ trigger }}_membership"() RETURNS trigger LANGUAGE plpgsql AS $scheme$
BEGIN
  IF NEW."scheme_id" IS DISTINCT FROM OLD."scheme_id" AND EXISTS (
    SELECT 1 FROM {{ source_table }} t WHERE t."{{ field.name.snake }}" = OLD."{{ key }}"
  ) THEN
    RAISE EXCEPTION 'cannot move a value used by a scheme-constrained link' USING ERRCODE = '23514';
  END IF;
  RETURN NEW;
END;
$scheme$;
CREATE TRIGGER "{{ ns }}_{{ trigger }}_membership" BEFORE UPDATE OF "scheme_id"
ON {{ value_table }} FOR EACH ROW EXECUTE FUNCTION "{{ ns }}"."{{ trigger }}_membership"();
CREATE FUNCTION "{{ ns }}"."{{ trigger }}_code"() RETURNS trigger LANGUAGE plpgsql AS $scheme$
BEGIN
  IF OLD."code" = {{ sql_literal(code) }} AND NEW."code" IS DISTINCT FROM OLD."code" AND EXISTS (
    SELECT 1 FROM {{ source_table }} t
    JOIN {{ value_table }} v ON v."{{ key }}" = t."{{ field.name.snake }}"
    WHERE v."scheme_id" = OLD."id"
  ) THEN
    RAISE EXCEPTION 'cannot rename a scheme used by a scheme-constrained link' USING ERRCODE = '23514';
  END IF;
  RETURN NEW;
END;
$scheme$;
CREATE TRIGGER "{{ ns }}_{{ trigger }}_code" BEFORE UPDATE OF "code"
ON "vocabulary"."schemes" FOR EACH ROW EXECUTE FUNCTION "{{ ns }}"."{{ trigger }}_code"();
{%- endif %}
{%- endfor %}
