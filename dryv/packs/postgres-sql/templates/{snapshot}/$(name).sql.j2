ALTER TABLE "{{ ns }}"."{{ table_of(schema) }}" ADD CONSTRAINT "fk_{{ table_of(schema) }}__{{ constraint.name.snake }}" FOREIGN KEY ("{{ constraint.field.snake }}"{% for item in constraint.match %}, "{{ item.snake }}"{% endfor %}) REFERENCES "{{ ns }}"."{{ table_of(schema) }}" ("{{ pk[0].snake }}"{% for item in constraint.match %}, "{{ item.snake }}"{% endfor %});
{%- elif constraint.kind == 'no-overlap' %}
