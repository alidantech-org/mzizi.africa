{%- endif %}{% endfor %}
ALTER TABLE "{{ ns }}"."{{ table_of(schema) }}" ADD CONSTRAINT "ex_{{ table_of(schema) }}__{{ constraint.name.snake }}" EXCLUDE USING gist ({{ elements.items | join(', ') }});
