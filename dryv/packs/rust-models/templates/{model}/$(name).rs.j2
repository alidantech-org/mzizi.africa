{#- Rust row struct for a stored entity. Mapping mirrors the rust-sql pack's PostgreSQL types;
    unsupported kinds abort generation via the `{}['message']` idiom. -#}
{%- macro rust_type(schema, field) -%}
{%- set value = field.value -%}
{%- if field.array is not none -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': array fields have no Rust mapping yet'] }}
{%- elif not value.is.property -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': nested schema values have no Rust mapping'] }}
{%- elif value.is.primitive -%}
  {%- set primitive = value.property.primitive -%}
  {%- if primitive.is.string and primitive.is.uuid -%}uuid::Uuid
  {%- elif primitive.is.string -%}String
  {%- elif primitive.is.boolean -%}bool
  {%- elif primitive.money is not none and primitive.money.minor_units -%}i64
  {%- elif primitive.is.integer and primitive.constraints.bits == 64 -%}i64
  {%- elif primitive.is.integer -%}i32
  {%- elif primitive.is.decimal -%}rust_decimal::Decimal
  {%- else -%}f64
  {%- endif -%}
{%- elif value.is.enum -%}String
{%- elif value.is.temporal -%}
  {%- set temporal = value.property.temporal -%}
  {%- if temporal.is.date -%}time::Date
  {%- elif temporal.is.time -%}time::Time
  {%- elif temporal.is.duration or temporal.is.interval -%}sqlx::postgres::types::PgInterval
  {%- else -%}time::OffsetDateTime
  {%- endif -%}
{%- else -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': property kind has no Rust mapping (record, composite, union, tuple, generic and literal are unsupported)'] }}
{%- endif -%}
{%- endmacro -%}
//! Generated by dryv pack mzizi.rust-models from the `database` authoring source. Do not edit.
//! {{ schema.facets.storage.namespace }}.{{ schema.facets.storage.name }}

#[derive(Debug, Clone, serde::Serialize, serde::Deserialize, sqlx::FromRow)]
pub struct {{ schema.name.pascal }} {
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}
{%- if field.relation is not none and field.relation.enforcement == 'reference' %}
    /// Application reference to {{ field.relation.target.schema.id }}; no SQL foreign key.
{%- endif %}
    pub {{ field.name.snake }}: {% if field.optional or field.nullable %}Option<{{ rust_type(schema, field) }}>{% else %}{{ rust_type(schema, field) }}{% endif %},
{%- endif %}{% endfor %}
}
