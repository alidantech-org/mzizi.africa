{#- Rust row struct for a stored entity. Mapping mirrors the rust-sql pack's PostgreSQL types;
    unsupported kinds abort generation via the `{}['message']` idiom. -#}
{%- macro rust_type(schema, field) -%}
{%- set value = field.value -%}
{%- if field.array is not none -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': array fields have no Rust mapping yet'] }}
{%- elif not value.is.property -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': nested schema values have no Rust mapping'] }}
{%- elif value.is.primitive -%}
  {%- set primitive = value.property.primitive -%}
  {%- if primitive.is.string and primitive.is.uuid -%}uuid::Uuid
  {%- elif primitive.is.string -%}String
  {%- elif primitive.is.boolean -%}bool
  {%- elif primitive.money is not none and primitive.money.minor_units -%}i64
  {%- elif primitive.is.integer and primitive.constraints.bits == 64 -%}i64
  {%- elif primitive.is.integer -%}i32
  {%- elif primitive.is.decimal -%}rust_decimal::Decimal
  {%- else -%}f64
  {%- endif -%}
{%- elif value.is.enum -%}String
{%- elif value.is.temporal -%}
  {%- set temporal = value.property.temporal -%}
  {%- if temporal.is.date -%}time::Date
  {%- elif temporal.is.time -%}time::Time
  {%- elif temporal.is.duration or temporal.is.interval -%}sqlx::postgres::types::PgInterval
  {%- else -%}time::OffsetDateTime
  {%- endif -%}
{%- else -%}{{ {}[schema.id ~ '.' ~ field.name.raw ~ ': property kind has no Rust mapping (record, composite, union, tuple, generic and literal are unsupported)'] }}
{%- endif -%}
{%- endmacro -%}
//! Generated by dryv pack mzizi.rust-models. Do not edit.
//! Checks every model against the live table it maps: each field's Rust type must be sqlx-compatible
//! with the column type PostgreSQL reports, and non-optional fields must not be nullable columns.

use sqlx::{Column, Executor, PgConnection, Postgres, Type, TypeInfo};

fn check<T: Type<Postgres>>(
    describe: &sqlx::Describe<Postgres>,
    index: usize,
    label: &str,
    optional: bool,
    errors: &mut Vec<String>,
) {
    let column = &describe.columns()[index];
    if !T::compatible(column.type_info()) {
        errors.push(format!("{label}: Rust type is not compatible with column type {}", column.type_info().name()));
    }
    if !optional && describe.nullable(index) == Some(true) {
        errors.push(format!("{label}: column is nullable but the field is not Option"));
    }
}

/// Returns every mismatch between the models and the databases (empty when they agree).
pub async fn verify(main: &mut PgConnection, operations: &mut PgConnection) -> Result<Vec<String>, sqlx::Error> {
    let mut errors = Vec::new();
{%- for schema in schemas %}
{%- set ns = schema.facets.storage.namespace %}
    {
        let connection: &mut PgConnection = {% if ns in pack.inputs.main_namespaces %}&mut *main{% elif ns in pack.inputs.operations_namespaces %}&mut *operations{% else %}{{ {}['namespace ' ~ ns ~ ' is not assigned to a database'] }}{% endif %};
        let describe = connection.describe("SELECT {% for field in schema.fields %}{% if field.related is none %}\"{{ field.name.snake }}\"{% if not loop.last %}, {% endif %}{% endif %}{% endfor %} FROM \"{{ ns }}\".\"{{ schema.facets.storage.name }}\"").await?;
        {%- set cols = namespace(i=0) %}
        {%- for field in schema.fields %}{% if field.related is none %}
        check::<{{ rust_type(schema, field) }}>(&describe, {{ cols.i }}, "{{ ns }}.{{ schema.facets.storage.name }}.{{ field.name.snake }}", {% if field.optional or field.nullable %}true{% else %}false{% endif %}, &mut errors);
        {%- set cols.i = cols.i + 1 %}
        {%- endif %}{% endfor %}
    }
{%- endfor %}
    Ok(errors)
}
