/**
 * Routes of the application's views, generated by Dryv from its destinations. Managed file: regenerated every time.
 * Hand-written pages and layouts import it for paths and navigation, so a renamed view fails to compile instead of
 * leaving a dead link.
 */
export const routes = {
{%- for view in views %}
  /** {{ view.description or view.name.title }} */
  {{ view.name.camel }}: "/{{ view.name.kebab }}",
{%- endfor %}
} as const;

export type RouteName = keyof typeof routes;

/** A route's path, with context values (such as a record identifier) as its query string. */
export function routePath(name: RouteName, context?: Record<string, string>): string {
  const query = context === undefined ? "" : new URLSearchParams(context).toString();
  return query === "" ? routes[name] : `${routes[name]}?${query}`;
}

/** The entries of the navigation, in view order. Detail views need context, so they are not listed. */
export const navigation: readonly { readonly name: RouteName; readonly label: string; readonly href: string }[] = [
{%- for view in views %}{% if view.role != 'detail' %}
  { name: "{{ view.name.camel }}", label: {{ view.name.title | tojson }}, href: "/{{ view.name.kebab }}" },
{%- endif %}{% endfor %}
];
