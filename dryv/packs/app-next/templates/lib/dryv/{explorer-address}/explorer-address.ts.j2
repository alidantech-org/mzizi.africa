export class ExplorerAddressError extends Error {}

/** The parsing boundary accepts literal query keys, never recursively expands dotted keys. */
export function parseExplorerAddress(query: URLSearchParams): {{ schema.name.pascal }} {
  const output: Record<string, string | number> = {};
  for (const key of query.keys()) {
    const field = explorerFields.find((candidate) => candidate.key === key);
    if (!field) throw new ExplorerAddressError(`Unknown query key: ${key}`);
    const entries = query.getAll(key);
    if (entries.length !== 1 || entries[0] === "") throw new ExplorerAddressError(`Supply one non-empty ${key}`);
    const value = entries[0]!;
    if ("choices" in field && !field.choices.some((choice) => choice === value)) throw new ExplorerAddressError(`Unsupported ${key}`);
    if (field.numeric) {
      const number = Number(value);
      if (!Number.isSafeInteger(number)) throw new ExplorerAddressError(`Invalid ${key}`);
      if (key.startsWith("page.") && number < 1) throw new ExplorerAddressError(`Invalid ${key}`);
      if (key === "page.limit" && number > 200) throw new ExplorerAddressError("Page limit exceeds 200");
      output[field.name] = number;
    } else output[field.name] = value;
  }
  output.view ??= "overview";
  const allowed = new Set(["view", "lang", "pageNo", "pageLimit", "sortBy", "sortOrder", ...ruleValues(viewFieldRules, String(output.view))]);
  for (const name of Object.keys(output)) {
    if (!allowed.has(name)) throw new ExplorerAddressError(`${name} is not supported by ${output.view}`);
  }
  if (output.entity && !ruleValues(viewEntityRules, String(output.view)).includes(String(output.entity))) throw new ExplorerAddressError("Record type is not supported by this view");
  if (Boolean(output.entity) !== Boolean(output.id)) throw new ExplorerAddressError("Record type and identity must be supplied together");
  if (output.provision && (output.view !== "laws" || output.entity !== "instrument")) throw new ExplorerAddressError("A provision requires its legal instrument");
  if (output.sortOrder && output.sortOrder !== "asc" && output.sortOrder !== "desc") throw new ExplorerAddressError("Invalid sort direction");
  return output as unknown as {{ schema.name.pascal }};
}

/** Only the URL serializer knows query key spelling. */
export function explorerAt(path: string, state: {{ schema.name.pascal }}): string {
  const query = new URLSearchParams();
  for (const field of explorerFields) {
    const value = state[field.name];
    if (value !== undefined && value !== null && !(field.name === "view" && value === "overview")) query.set(field.key, String(value));
  }
  const base = `/${path.split("/").filter(Boolean).join("/")}`;
  return query.size ? `${base}?${query}` : base;
}

/** Changing subject preserves only explicit language. */
export function explorerViewAt(path: string, view: {{ schema.name.pascal }}["view"], current: {{ schema.name.pascal }}): string {
  return explorerAt(path, { view, lang: current.lang });
}

/** Changing place clears record selection and paging. */
export function explorerPlaceAt(path: string, current: {{ schema.name.pascal }}): string {
  return explorerAt(path, { view: current.view, tab: current.tab, lang: current.lang });
}

