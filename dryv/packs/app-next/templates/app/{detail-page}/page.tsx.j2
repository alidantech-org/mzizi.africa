{#- The detail pattern: one record read when the view opens, shown as labelled values with a table for each
    list of records inside it. The view's context values arrive as address (query) values. -#}
{%- macro bound_client(operation) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == operation.id and dependency.slot == 'operation.client' -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro own(operation) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == operation.id and dependency.template == 'operation' and dependency.slot is none -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- for part in view.parts if part.kind == 'present' -%}{%- if loop.first -%}
{%- set op = part.present.source.port.operation -%}
"use client";

import { Suspense, useEffect, useState } from "react";
import { useSearchParams } from "next/navigation";

import { DataTable } from "{{ pack.inputs.ui_package }}/components/data-table.tsx";
import { DetailList } from "{{ pack.inputs.ui_package }}/components/detail-list.tsx";
import { PageShell, Section } from "{{ pack.inputs.ui_package }}/components/page-shell.tsx";
{%- for dependency in file.dependencies %}{% if dependency.symbol %}
{%- if dependency.slot == 'operation.client' %}
import { {{ dependency.symbol }} } from "{{ pack.inputs.sdk_package }}/{{ dependency.path.prefixed | replace('#sdk/', '') }}";
{%- elif dependency.template == 'operation' %}
import { {{ dependency.symbol }}Request } from "{{ dependency.path.prefixed | replace('.ts', '') }}.ts";
{%- endif %}
{%- endif %}{% endfor %}

/** {{ view.description or view.name.title }} */
type Record_ = Record<string, unknown>;

const scalars = [
{%- for field in part.present.source.port.value.schema.fields %}{% if field.value.kind == 'property' and field.array is none %}
  { key: {{ field.name.raw | tojson }}, label: {{ field.name.title | tojson }} },
{%- endif %}{% endfor %}
];

const lists = [
{%- for field in part.present.source.port.value.schema.fields %}{% if field.value.kind == 'schema' and field.array is not none %}
  {
    key: {{ field.name.raw | tojson }},
    label: {{ field.name.title | tojson }},
    columns: [
{%- for column in field.value.schema.fields %}{% if column.value.kind == 'property' and column.array is none %}
      { key: {{ column.name.raw | tojson }}, label: {{ column.name.title | tojson }} },
{%- endif %}{% endfor %}
    ],
  },
{%- endif %}{% endfor %}
];

function {{ file.symbol }}Content() {
  const address = useSearchParams();
{%- for item in view.context %}
  const {{ item.name.camel }} = address.get({{ item.name.raw | tojson }});
{%- endfor %}
  const [record, setRecord] = useState<Record_ | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
{%- for load in view.parts if load.kind == 'invoke' and 'run:on-open' in load.tags %}
    void {{ bound_client(op) or own(op) }}(
      {{ own(op) }}Request({
{%- for b in load.invoke.context %}
        {{ b.target.field.camel }}: {{ b.source.name.camel }} ?? undefined,
{%- endfor %}
      }) as never,
    ).then((response) => {
      if (!response.success) {
        setError(response.message);
        return;
      }
      setRecord(response.body as Record_ | null);
    });
{%- endfor %}
  }, [{% for item in view.context %}{{ item.name.camel }}{% if not loop.last %}, {% endif %}{% endfor %}]);

  return (
    <PageShell title={{ view.name.title | tojson }}>
      {error === null ? null : <p role="alert">{error}</p>}
      {record === null ? null : (
        <>
          <Section>
            <DetailList
              entries={scalars.map((field) => ({
                label: field.label,
                value: record[field.key] == null ? null : String(record[field.key]),
              }))}
              missingText="Not recorded"
            />
          </Section>
          {lists.map((list) => (
            <Section key={list.key} title={list.label}>
              <DataTable
                columns={list.columns}
                rows={(record[list.key] as readonly Record_[] | undefined) ?? []}
                rowKey={(_row, index) => String(index)}
                cell={(row, key) => String(row[key] ?? "")}
                emptyText="None recorded."
              />
            </Section>
          ))}
        </>
      )}
    </PageShell>
  );
}

export default function {{ file.symbol }}() {
  return (
    <Suspense>
      <{{ file.symbol }}Content />
    </Suspense>
  );
}
{%- endif -%}{%- endfor -%}
