/** Generated from {{ schema.id }} by mzizi.app-next. Product reads execute on the server. */
import { notFound, redirect } from "next/navigation";
import { loadContext, serverLanguage, unwrap } from "#/lib/server/data.ts";
import { parseExplorerAddress, explorerAt, explorerNavigation, legacyExplorerSections } from "#/lib/dryv/explorer-address.ts";
import { ExplorerScreen } from "#/components/site/explorer-screen.tsx";
import { getCountryContext } from "@mzizi/api-client/actions/structure/get-country-context.actions.ts";
import { getLocality } from "@mzizi/api-client/actions/locality/get-locality.actions.ts";
import { getStructureScreen } from "@mzizi/api-client/actions/structure/get-structure-screen.actions.ts";

export const dynamic = "force-dynamic";
interface PageInput {
  params: Promise<{ path: string[] }>;
  searchParams: Promise<Record<string, string | string[] | undefined>>;
}

export default async function ExplorerPage({ params, searchParams }: PageInput) {
  const [{ path }, raw] = await Promise.all([params, searchParams]);
  const query = new URLSearchParams();
  for (const [key, value] of Object.entries(raw)) {
    if (Array.isArray(value)) value.forEach((item) => query.append(key, item));
    else if (value !== undefined) query.set(key, value);
  }
  let state;
  try { state = parseExplorerAddress(query); }
  catch (error) { return <main className="p-8"><h1>Invalid explorer address</h1><p role="alert">{error instanceof Error ? error.message : "Invalid parameters"}</p></main>; }
  const context = await loadContext(path.join("/"));
  if (!context) notFound();
  if (context.country.code.toLowerCase() !== path[0]?.toLowerCase()) {
    if (!context.place) notFound();
    const section = context.rest.join("/");
    const view = legacyExplorerSections[section] ?? explorerNavigation.find((entry) => entry.view === section)?.view ?? (section ? undefined : state.view);
    if (!view) notFound();
    redirect(explorerAt([context.country.code, context.place.path].join("/"), { ...state, view }));
  }
  if (context.rest.length) notFound();
  if (path.length > 1 && !context.place) notFound();
  const country = context.country.isoCode ? await unwrap(getCountryContext({ query: { countryCode: context.country.isoCode } })) : null;
  const featureId = context.place?.featureId ?? country?.levels.find((level) => level.routing && level.rootFeatureId)?.rootFeatureId ?? undefined;
  const language = state.lang ?? await serverLanguage();
  const locality = state.view === "overview" && featureId ? await unwrap(getLocality({ params: { featureId }, query: { languageCode: language } })) : null;
  const structure = context.country.isoCode && (state.view === "leaders" || state.view === "institutions")
    ? await unwrap(getStructureScreen({ query: { countryCode: context.country.isoCode } })) : null;
  return <ExplorerScreen context={context} state={state} structure={structure} locality={locality} featureId={featureId} language={language} />;
}
