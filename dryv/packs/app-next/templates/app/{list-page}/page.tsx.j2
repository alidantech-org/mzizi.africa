{#- The list pattern: filters over a paged table whose rows open the related destination. Hand-written components
    implement it; this template only fills their props from the contract. -#}
{%- macro bound_client(operation) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == operation.id and dependency.slot == 'operation.client' -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro own(operation) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == operation.id and dependency.template == 'operation' and dependency.slot is none -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro this_destination() -%}{%- for d in application.destinations -%}{%- if d.view.id == view.id -%}{{ d.name.raw }}{%- endif -%}{%- endfor -%}{%- endmacro -%}
{#- The route of the destination this view's destination leads to, or nothing when it leads nowhere. -#}
{%- macro target_route() -%}{%- set me = this_destination() -%}{%- for t in application.transitions -%}{%- if t.source.raw == me -%}{%- for d in application.destinations -%}{%- if d.name.raw == t.target.raw -%}/{{ view.group.name.kebab }}/{{ d.view.name.kebab }}{%- endif -%}{%- endfor -%}{%- endif -%}{%- endfor -%}{%- endmacro -%}
{%- set route = target_route() -%}
{%- for part in view.parts if part.kind == 'present' -%}{%- if loop.first -%}
{%- set op = part.present.source.port.operation -%}
{%- set select = part.present.source.select[0].dotted -%}
"use client";

import { useCallback, useEffect, useState } from "react";
{%- if route != '' %}
import { useRouter } from "next/navigation";
{%- endif %}

import { DataTable } from "{{ pack.inputs.ui_package }}/components/data-table.tsx";
import { FilterBar } from "{{ pack.inputs.ui_package }}/components/filter-bar.tsx";
import { PageShell, Section } from "{{ pack.inputs.ui_package }}/components/page-shell.tsx";
import { Pagination } from "{{ pack.inputs.ui_package }}/components/pagination.tsx";
import type { FieldSpec, FieldValues, PageWindow } from "{{ pack.inputs.ui_package }}/lib/types.ts";
{%- for dependency in file.dependencies %}{% if dependency.symbol %}
{%- if dependency.slot == 'operation.client' %}
import { {{ dependency.symbol }} } from "{{ pack.inputs.sdk_package }}/{{ dependency.path.prefixed | replace('#sdk/', '') }}";
{%- elif dependency.template == 'operation' %}
import { {{ dependency.symbol }}Page, {{ dependency.symbol }}Request } from "{{ dependency.path.prefixed | replace('.ts', '') }}.ts";
{%- endif %}
{%- endif %}{% endfor %}

/** {{ view.description or view.name.title }} */
const filterFields: readonly FieldSpec[] = [
{%- for part in view.parts %}{% if part.kind == 'collect' and part.collect.target.port is not none %}
{%- set port = part.collect.target.port %}
{%- for path in part.collect.target.collect %}{% for field in port.value.schema.fields %}{% if field.name.raw == path.dotted %}
{%- if field.sources | length > 0 %}{% for source in field.sources if source.purpose == 'options' %}{% if loop.first %}
  {
    kind: "choice",
    name: {{ field.name.raw | tojson }},
    label: {{ field.name.title | tojson }},
    // The choices come from {{ source.output.operation.name.raw }}: its first list of records, each record's
    // `option:value` field as the value and `option:label` field as the text.
    loadOptions: async () => {
      const response = await {% for dependency in file.dependencies %}{% if dependency.slot == 'operation.client' and dependency.target.id == source.output.operation.id %}{{ dependency.symbol }}{% endif %}{% endfor %}({} as never);
      const body = response.body as Record<string, unknown> | null;
{%- for list in source.output.value.schema.fields if list.value.kind == 'schema' and list.array is not none %}{% if loop.first %}
      const records = (body?.[{{ list.name.raw | tojson }}] as readonly Record<string, unknown>[] | undefined) ?? [];
      return records.map((record) => ({
{%- for item in list.value.schema.fields %}{% if 'option:value' in item.tags %}
        value: String(record[{{ item.name.raw | tojson }}]),
{%- elif 'option:label' in item.tags %}
        label: String(record[{{ item.name.raw | tojson }}]),
{%- endif %}{% endfor %}
      }));
{%- endif %}{% endfor %}
    },
  },
{%- endif %}{% endfor %}
{%- else %}
  { kind: "text", name: {{ field.name.raw | tojson }}, label: {{ field.name.title | tojson }} },
{%- endif %}
{%- endif %}{% endfor %}{% endfor %}
{%- endif %}{% endfor %}
];

const columns = [
{%- for field in part.present.source.port.value.schema.fields %}{% if field.name.raw == select %}
{%- for column in field.value.schema.fields %}{% if column.value.kind == 'property' and column.array is none %}
  { key: {{ column.name.raw | tojson }}, label: {{ column.name.title | tojson }} },
{%- endif %}{% endfor %}
{%- endif %}{% endfor %}
];

type Row = Record<string, unknown>;

const PAGE_SIZE = {{ pack.inputs.page_size }};

export default function {{ file.symbol }}() {
{%- if route != '' %}
  const router = useRouter();
{%- endif %}
  const [filters, setFilters] = useState<FieldValues>({});
  const [window, setWindow] = useState<PageWindow>({ limit: PAGE_SIZE, offset: 0 });
  const [rows, setRows] = useState<readonly Row[]>([]);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    const paging = {{ own(op) }}Page;
    const input: Record<string, unknown> = {};
    for (const [name, value] of Object.entries(filters)) if (value !== "") input[name] = value;
    if (paging !== undefined) {
      input[paging.limit] = Math.min(window.limit, paging.maxLimit);
      input[paging.offset] = window.offset;
    }
    const response = await {{ bound_client(op) or own(op) }}({{ own(op) }}Request({ input: input as never }) as never);
    if (!response.success) {
      setError(response.message);
      setRows([]);
      return;
    }
    setError(null);
    const body = response.body as Record<string, unknown> | null;
    setRows((body?.[{{ select | tojson }}] as readonly Row[] | undefined) ?? []);
  }, [filters, window]);

  useEffect(() => {
    void load();
  }, [load]);

  return (
    <PageShell title={{ view.name.title | tojson }}>
      <Section>
        <FilterBar
          fields={filterFields}
          initial={filters}
          submitLabel="Apply"
          onSubmit={(values) => {
            setFilters(values);
            setWindow({ limit: window.limit, offset: 0 });
          }}
        />
      </Section>
      <Section>
        {error === null ? null : <p role="alert">{error}</p>}
        <DataTable
          columns={columns}
          rows={rows}
          rowKey={(row, index) => String(index)}
          cell={(row, key) => String(row[key] ?? "")}
{%- if route != '' %}
          onOpen={(row) => {
            // The row's text values travel as the target's context values, matched by name.
            const values = new URLSearchParams();
            for (const [name, value] of Object.entries(row)) if (typeof value === "string") values.set(name, value);
            router.push(`{{ route }}?${values.toString()}`);
          }}
{%- endif %}
          emptyText="Nothing matches."
        />
        <Pagination window={window} received={rows.length} onChange={setWindow} />
      </Section>
    </PageShell>
  );
}
{%- endif -%}{%- endfor -%}
