{
  "name": "{{ application.name.kebab }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev -p {{ pack.inputs.port }}",
    "build": "bun --bun next build",
    "start": "bun --bun next start -p {{ pack.inputs.port }}",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "{{ pack.inputs.sdk_package }}": "workspace:*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
