{#- Generated from the application's Theme. Do not edit: change dryv/contracts/schemas/theme.ts. -#}
{%- macro kebab(name) -%}{{ name|replace('A','-a')|replace('B','-b')|replace('C','-c')|replace('D','-d')|replace('E','-e')|replace('F','-f')|replace('G','-g')|replace('H','-h')|replace('I','-i')|replace('J','-j')|replace('K','-k')|replace('L','-l')|replace('M','-m')|replace('N','-n')|replace('O','-o')|replace('P','-p')|replace('Q','-q')|replace('R','-r')|replace('S','-s')|replace('T','-t')|replace('U','-u')|replace('V','-v')|replace('W','-w')|replace('X','-x')|replace('Y','-y')|replace('Z','-z') }}{%- endmacro -%}
{%- macro dim(v) -%}{{ v.value }}{{ v.unit }}{%- endmacro -%}
{%- macro css(token) -%}
{%- set v = token.value_json | fromjson -%}
{%- if token.kind == 'dimension' -%}{{ dim(v) }}
{%- elif token.kind == 'font-family' -%}{% for f in v %}{% if ' ' in f %}"{{ f }}"{% else %}{{ f }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
{%- elif token.kind == 'shadow' -%}{{ dim(v.offset_x) }} {{ dim(v.offset_y) }} {{ dim(v.blur) }} {{ dim(v.spread) }} {{ v.color }}
{%- elif token.kind == 'cubic-bezier' -%}cubic-bezier({{ v | join(', ') }})
{%- elif token.kind == 'duration' -%}{{ v }}ms
{%- else -%}{{ v }}
{%- endif -%}
{%- endmacro -%}
/* Generated by Dryv from the Theme "{{ application.theme.name.pascal }}". Do not edit. */

:root {
{%- for token in application.theme.tokens %}
  --{{ kebab(token.name) }}: {{ css(token) }};
{%- endfor %}
{%- for role in application.theme.roles %}
  --{{ role.role | replace('.', '-') }}: var(--{{ kebab(role.token.name) }});
{%- endfor %}
}
{% for mode in application.theme.modes if mode.color_scheme == 'dark' %}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
{%- for role in mode.roles %}
    --{{ role.role | replace('.', '-') }}: var(--{{ kebab(role.token.name) }});
{%- endfor %}
  }
}

:root[data-theme="dark"] {
{%- for role in mode.roles %}
  --{{ role.role | replace('.', '-') }}: var(--{{ kebab(role.token.name) }});
{%- endfor %}
}
{% endfor %}
/* Tailwind v4 utilities: radius, font and shadow tokens as literals (rounded-lg, font-display, shadow-lift), and colours and roles as variables (bg-clay, bg-surface-background). */
@theme {
{%- for token in application.theme.tokens %}
{%- if token.kind in ('dimension', 'font-family', 'shadow') %}
  --{{ kebab(token.name) }}: {{ css(token) }};
{%- endif %}
{%- endfor %}
}

@theme inline {
{%- for token in application.theme.tokens %}
{%- if token.kind == 'color' %}
  --color-{{ kebab(token.name) }}: var(--{{ kebab(token.name) }});
{%- endif %}
{%- endfor %}
{%- for role in application.theme.roles %}
  --color-{{ role.role | replace('.', '-') }}: var(--{{ role.role | replace('.', '-') }});
{%- endfor %}
}
