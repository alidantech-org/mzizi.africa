    is a null test (IS [NOT] NULL); SQL three-valued logic otherwise matches the contract. -#}
{%- macro is_null_literal(node) -%}{%- if node.kind == 'literal' and node.value is none -%}1{%- endif -%}{%- endmacro -%}
{%- macro x0(node, where) -%}
{%- if node.kind == 'literal' -%}{%- if node.value is none -%}NULL{%- else -%}{{ node.value | tojson | replace('"', "'") }}{%- endif -%}
{%- elif node.kind == 'context' -%}"{{ node.path.dotted }}"
{%- else -%}{{ {}[where ~ ': invariant expression is nested deeper than the supported depth or uses kind ' ~ node.kind] }}
{%- endif -%}
{%- endmacro -%}
{%- macro x1(node, where) -%}
{%- if node.kind == 'literal' or node.kind == 'context' -%}{{ x0(node, where) }}
{%- elif node.kind == 'comparison' -%}
  {%- if is_null_literal(node.right) -%}({{ x0(node.left, where) }} IS {% if node.operator == 'not-equal' %}NOT {% endif %}NULL)
  {%- elif is_null_literal(node.left) -%}({{ x0(node.right, where) }} IS {% if node.operator == 'not-equal' %}NOT {% endif %}NULL)
  {%- else -%}({{ x0(node.left, where) }} {{ sql_operator(node.operator) }} {{ x0(node.right, where) }})
  {%- endif -%}
{%- elif node.kind == 'logical' -%}({% for item in node.values %}{{ x0(item, where) }}{% if not loop.last %} {% if node.operator == 'and' %}AND{% else %}OR{% endif %} {% endif %}{% endfor %})
{%- elif node.kind == 'unary' and node.operator == 'not' -%}(NOT {{ x0(node.value, where) }})
{%- elif node.kind == 'arithmetic' -%}({% for item in node.values %}{{ x0(item, where) }}{% if not loop.last %} {% if node.operator == 'add' %}+{% elif node.operator == 'subtract' %}-{% elif node.operator == 'multiply' %}*{% else %}/{% endif %} {% endif %}{% endfor %})
{%- else -%}{{ {}[where ~ ': invariant expression kind ' ~ node.kind ~ ' has no SQL CHECK mapping'] }}
{%- endif -%}
{%- endmacro -%}
