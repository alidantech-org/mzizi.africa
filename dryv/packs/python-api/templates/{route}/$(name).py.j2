{%- macro symbol_for(link) -%}
{%- for dependency in file.dependencies -%}
{%- if dependency.target.id == link.id and dependency.symbol -%}{{ dependency.symbol }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro value_type(value) -%}
{%- if value.is.schema -%}{{ value.schema.name.pascal }}
{%- elif value.is.unknown or value.is.dynamic -%}JsonValue
{%- elif value.is.primitive and value.property.primitive.is.boolean -%}bool
{%- elif value.is.primitive and value.property.primitive.is.integer -%}int
{%- elif value.is.primitive and value.property.primitive.is.number -%}float
{%- elif value.is.primitive and value.property.primitive.is.uuid -%}UUID
{%- elif value.is.primitive -%}str
{%- elif value.is.enum -%}{{ value.property.enum.name.pascal }}
{%- else -%}JsonValue
{%- endif -%}
{%- endmacro -%}
{%- macro result_type(operation) -%}
{%- if operation.output %}{{ value_type(operation.output.value) }}{% else %}None{% endif -%}
{%- endmacro -%}
{%- macro binds_whole(http) -%}
{%- for binding in http.inputs %}{% if binding.port.field is none %}x{% endif %}{% endfor -%}
{%- endmacro -%}
{%- macro service_params(operation, http) -%}
{%- if binds_whole(http) -%}
{%- for binding in http.inputs %}, input: {{ value_type(binding.port.value) }}{% endfor -%}
{%- elif http.inputs -%}, *{% for binding in http.inputs %}, {{ binding.port.name.snake }}: {{ value_type(binding.port.value) }}{% if optional(operation, binding) %} | None{% endif %}{% endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- macro optional(operation, binding) -%}{%- if operation.input is not none and binding.port.field is not none -%}{%- for field in operation.input.fields -%}{%- if field.name.camel == binding.port.name.camel and field.optional -%}x{%- endif -%}{%- endfor -%}{%- endif -%}{%- endmacro -%}
{%- macro path_of(http) -%}{{ http.path.local }}{%- endmacro -%}
"""Routes for {{ feature.name.title }}, generated by Dryv; the engine implements {{ file.symbols.service }}."""

