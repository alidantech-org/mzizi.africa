from abc import ABC, abstractmethod
from collections.abc import Awaitable, Callable
from typing import Annotated
from uuid import UUID

from fastapi import APIRouter, Body, Depends, Path, Query, Request

from mzizi_engine.jsonvalue import JsonValue
{%- for dependency in file.dependencies %}{% if dependency.symbol %}
from {{ dependency.path.prefixed | replace('/', '.') | replace('.py', '') }} import {{ dependency.symbol }}
{%- endif %}{% endfor %}

{%- for operation in operations %}{% if operation.output and operation.output.value.is.schema and 'mongo' in operation.output.value.schema.tags %}
from mzizi_engine.api.schemas.mongo.{{ operation.output.value.schema.group.name.snake }}.models.{{ operation.output.value.schema.name.snake }} import {{ operation.output.value.schema.name.pascal }}
{%- endif %}{% for binding in operation.facets.http.inputs %}{% if binding.port.value.is.schema and 'mongo' in binding.port.value.schema.tags %}
from mzizi_engine.api.schemas.mongo.{{ binding.port.value.schema.group.name.snake }}.models.{{ binding.port.value.schema.name.snake }} import {{ binding.port.value.schema.name.pascal }}
{%- endif %}{% if binding.port.value.is.enum and not symbol_for(binding.port.value.property.enum) %}
from mzizi_engine.api.schemas.{% if 'mongo' in binding.port.value.property.enum.tags %}mongo{% else %}api{% endif %}.{{ binding.port.value.property.enum.group.name.snake }}.enums.{{ binding.port.value.property.enum.name.snake }} import {{ binding.port.value.property.enum.name.pascal }}
{%- endif %}{% endfor %}{% endfor %}

__all__ = ["{{ file.symbols.service }}", "{{ file.symbols.router }}"]

type Guard = Callable[[Request], Awaitable[None]]
"""An async FastAPI dependency that raises 401 or 403 before the route runs."""


class {{ file.symbols.service }}(ABC):
    """What {{ feature.name.title }} needs from handwritten code. Raise ``fastapi.HTTPException`` for failures."""
{% for operation in operations %}
    @abstractmethod
    async def {{ operation.name.snake }}(self{{ service_params(operation, operation.facets.http) }}) -> {{ result_type(operation) }}:
        """{{ operation.description or operation.name.title }}"""
{% endfor %}

def {{ file.symbols.router }}(service: {{ file.symbols.service }}, guard: Guard | None = None) -> APIRouter:
    """Routes for {{ feature.name.title }}, delegating to ``service``; ``guard`` protects every route."""

    router = APIRouter(tags=["{{ feature.name.title }}"], dependencies=[Depends(guard)] if guard else [])
{% for operation in operations %}
{%- set http = operation.facets.http %}
    @router.{{ http.method | lower }}(
        "{{ path_of(http) }}",
        response_model={{ result_type(operation) }},
        status_code={% for binding in http.outputs %}{{ binding.status }}{% else %}200{% endfor %},
        summary={{ (operation.description or operation.name.title) | tojson }},
    )
    async def {{ operation.name.snake }}(
{%- for binding in http.inputs %}
        {{ binding.port.name.snake }}: Annotated[{{ value_type(binding.port.value) }}{% if optional(operation, binding) %} | None{% endif %}, {% if binding.is.path %}Path(alias="{{ binding.name }}"){% elif binding.is.query %}Query(alias="{{ binding.name }}"){% else %}Body(){% endif %}]{% if optional(operation, binding) %} = None{% endif %},
{%- endfor %}
    ) -> {{ result_type(operation) }}:
        return await service.{{ operation.name.snake }}(
{%- if binds_whole(http) %}{% for binding in http.inputs %}{{ binding.port.name.snake }}{% endfor %}
{%- else %}{% for binding in http.inputs %}{{ binding.port.name.snake }}={{ binding.port.name.snake }}{% if not loop.last %}, {% endif %}{% endfor %}
{%- endif %})
{% endfor %}
    return router
