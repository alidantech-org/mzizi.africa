{#- Paging of one operation: the names of its window inputs and the largest page, read from its query plan. -#}
// Generated by Dryv from the query plan of {{ operation.name.raw }}. Do not edit.

import 'package:{{ pack.inputs.ui_package }}/{{ pack.inputs.ui_package }}.dart';
{%- if operation.persistence %}{% set plan = operation.persistence.document | fromjson %}
{%- if plan.read is not none and plan.read.page is not none %}

/// Paging of this list operation.
const PageNames {{ file.symbol }} = PageNames(
  limit: '{{ plan.read.page.limit }}',
  offset: '{{ plan.read.page.offset }}',
  maxLimit: {{ plan.read.page.max_limit }},
);
{%- else %}

/// This operation is not paged.
const PageNames {{ file.symbol }} = PageNames.none();
{%- endif %}
{%- else %}

/// This operation has no query plan, so no paging is known.
const PageNames {{ file.symbol }} = PageNames.none();
{%- endif %}
