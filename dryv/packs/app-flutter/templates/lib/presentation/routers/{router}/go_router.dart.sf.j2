import 'package:go_router/go_router.dart';
import 'package:mzizi_app/presentation/routers/_utils.dart';
import 'package:mzizi_app/presentation/screens/home/home_screen.dart';
import 'package:mzizi_app/presentation/shell/app_shell.dart';
{#- "yes" when an earlier view already introduced the view's feature. -#}
{%- macro feature_seen(view, position) -%}
{%- for other in views %}{% if loop.index < position and other.feature is not none and view.feature is not none and other.feature.id == view.feature.id %}yes{% endif %}{% endfor -%}
{%- endmacro %}
{%- for view in views %}{% if view.feature is not none and feature_seen(view, loop.index) == '' %}
import 'package:{{ application.name.snake }}/presentation/screens/{{ view.feature.name.snake }}/_{{ view.feature.name.snake }}.router.dart';
{%- endif %}{% endfor %}

/// The app's router. Scaffolded by Dryv once; this file belongs to the app: arrange the routes, the shell and the
/// home screen as you like. The generated feature routes (reference screens) are listed here so every view has a
/// root-level path (`AppRoutes` in `navigation.dart`); replace any of them with your own screen.
final appRouter = GoRouter(
  initialLocation: '/',
  routes: [
    ShellRoute(
      builder: (context, state, child) => AppShell(location: state.uri.path, child: child),
      routes: [
        GoRoute(
          path: '/',
          pageBuilder: (context, state) => fadeTransition(child: const HomeScreen()),
        ),
{%- for view in views %}{% if view.feature is not none and feature_seen(view, loop.index) == '' %}
        ...{{ view.feature.name.camel }}RouterRoutes,
{%- endif %}{% endfor %}
      ],
    ),
  ],
);
