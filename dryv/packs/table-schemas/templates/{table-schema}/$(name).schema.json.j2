{#- Everything is derived from the contracts. Column types use a small closed vocabulary that the manifest package maps to checks. -#}
{%- macro table_of(schema) -%}{%- set storage = schema.facets.storage -%}{%- if storage is not none and storage.name is not none -%}{{ storage.name }}{%- else -%}{{ schema.name.snake }}{%- endif -%}{%- endmacro -%}
{%- macro qualified(schema) -%}{{ schema.facets.storage.namespace }}.{{ table_of(schema) }}{%- endmacro -%}
{%- macro kind(field) -%}
{%- set value = field.value -%}
{%- if value.is.primitive -%}
  {%- set primitive = value.property.primitive -%}
  {%- if primitive.is.string and primitive.is.uuid -%}uuid
  {%- elif primitive.is.string -%}text
  {%- elif primitive.is.boolean -%}boolean
  {%- elif primitive.money is not none and primitive.money.minor_units -%}integer
  {%- elif primitive.is.integer -%}integer
  {%- elif primitive.is.decimal -%}decimal
  {%- else -%}number
  {%- endif -%}
{%- elif value.is.enum -%}text
{%- elif value.is.temporal -%}
  {%- set temporal = value.property.temporal -%}
  {%- if temporal.is.date -%}date
  {%- elif temporal.is.time -%}time
  {%- elif temporal.is.duration or temporal.is.interval -%}interval
  {%- else -%}timestamp
  {%- endif -%}
{%- else -%}{{ {}[field.name.raw ~ ': property kind has no column type'] }}
{%- endif -%}
{%- endmacro -%}
{%- macro is_primary(storage, field) -%}
{%- for key in storage.primary_key -%}{%- if key.raw == field.name.raw -%}yes{%- endif -%}{%- endfor -%}
{%- endmacro -%}
{%- macro managed(field) -%}{%- if field.mutation == 'system' -%}yes{%- endif -%}{%- endmacro -%}
{%- macro alias_of(field) -%}{{ ((field.name.snake ~ '|') | replace('_id|', '_code')) | replace('|', '_code') }}{%- endmacro -%}
{%- macro is_link(field) -%}{%- if field.relation is not none and field.relation.enforcement == 'foreign-key' -%}yes{%- endif -%}{%- endmacro -%}
{%- macro json_type(field) -%}
{%- set k = kind(field) | trim -%}
{%- if k == 'boolean' -%}"boolean"
{%- elif k == 'integer' -%}"integer"
{%- elif k == 'number' -%}"number"
{%- else -%}"string"
{%- endif -%}
{%- endmacro -%}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.alidantech.org/mzizi/public/schemas/database/{{ group.name.kebab }}.schema.json",
  "code": "sys.sch.{{ group.name.kebab }}",
  "title": {{ (group.name.kebab ~ " tables") | tojson }},
  "description": "Generated by dryv pack mzizi.table-schemas from the contracts; do not edit. Its code is sys.sch.<group>; each table's x-code is sys.tbl.<group>.<table> (underscores written as dashes). Each $defs entry is one table: properties are the stored columns, each with an x-role (key, data, link or system); x-seed is the shape of a seed file row (natural key, data, and links written as the target's code, never ids or system fields); the natural key is the code, or for a one-to-one extension table the link that is its primary key. A link names its target table by contract id (x-id) and its seed alias in x-link.",
  "x-group": {{ group.name.kebab | tojson }},
  "$defs": {
{%- for schema in schemas %}{% set storage = schema.facets.storage %}
    {{ table_of(schema) | trim | tojson }}: {
      "title": {{ qualified(schema) | trim | tojson }},
      "type": "object",
      "additionalProperties": false,
      "x-code": "sys.tbl.{{ group.name.kebab }}.{{ table_of(schema) | trim | replace('_', '-') }}",
      "x-id": {{ schema.id | tojson }},
      "x-table": {{ qualified(schema) | trim | tojson }},
      "x-primaryKey": [{% for key in storage.primary_key %}{{ key.snake | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}],
{%- set nk = namespace(has=false) -%}
{%- for index in storage.indexes %}{% if index.unique and (index.fields | length) == 1 %}{% for item in index.fields %}{% if item.snake == 'code' %}{% set nk.has = true %}{% endif %}{% endfor %}{% endif %}{% endfor %}
{%- set nlk = namespace(names=[]) -%}
{%- if not nk.has %}{% for field in schema.fields %}{% if field.related is none and field.value is not none and (is_link(field) | trim) and (is_primary(storage, field) | trim) %}{% set nlk.names = nlk.names + [alias_of(field) | trim] %}{% endif %}{% endfor %}{% endif %}
      "x-naturalKey": [{% if nk.has %}"code"{% else %}{% for name in nlk.names %}{{ name | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}],
      "x-seedable": {{ 'true' if (nk.has or (nlk.names | length) > 0) else 'false' }},
      "x-uniqueKeys": [
{%- set firstkey = namespace(value=true) -%}
{%- for index in storage.indexes %}{% if index.unique %}
        {% if not firstkey.value %},{% endif %}{% set firstkey.value = false %}[{% for item in index.fields %}{{ item.snake | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}{% endfor %}
      ],
      "required": [
{%- set firstreq = namespace(value=true) -%}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}{% if not (field.optional or field.nullable or (field.default is not none and field.default.kind == 'value') or (managed(field) | trim)) %}
        {% if not firstreq.value %},{% endif %}{% set firstreq.value = false %}{{ field.name.snake | tojson }}
{%- endif %}{% endif %}{% endfor %}
      ],
      "x-seed": {
        "system": [
{%- set fs = namespace(value=true) -%}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}{% if (managed(field) | trim) or (nk.has and (is_primary(storage, field) | trim)) %}
          {% if not fs.value %},{% endif %}{% set fs.value = false %}{{ field.name.snake | tojson }}
{%- endif %}{% endif %}{% endfor %}
        ],
        "columns": [
{%- set fc = namespace(value=true) -%}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}{% if not ((managed(field) | trim) or (nk.has and (is_primary(storage, field) | trim))) %}
          {% if not fc.value %},{% endif %}{% set fc.value = false %}{% if is_link(field) | trim %}{{ alias_of(field) | trim | tojson }}{% else %}{{ field.name.snake | tojson }}{% endif %}
{%- endif %}{% endif %}{% endfor %}
        ],
        "required": [
{%- set fr = namespace(value=true) -%}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}{% if not ((managed(field) | trim) or (nk.has and (is_primary(storage, field) | trim)) or field.optional or field.nullable or (field.default is not none and field.default.kind == 'value')) %}
          {% if not fr.value %},{% endif %}{% set fr.value = false %}{% if is_link(field) | trim %}{{ alias_of(field) | trim | tojson }}{% else %}{{ field.name.snake | tojson }}{% endif %}
{%- endif %}{% endif %}{% endfor %}
        ]
      },
      "properties": {
{%- set first = namespace(value=true) -%}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}
        {% if not first.value %},{% endif %}{% set first.value = false %}{{ field.name.snake | tojson }}: {
          "type": {% if field.optional or field.nullable %}[{{ json_type(field) | trim }}, "null"]{% else %}{{ json_type(field) | trim }}{% endif %},
          "x-type": {{ kind(field) | trim | tojson }}
{%- set k = kind(field) | trim %}
{%- if k == 'uuid' %},
          "format": "uuid"
{%- elif k == 'date' %},
          "format": "date"
{%- elif k == 'time' %},
          "format": "time"
{%- elif k == 'timestamp' %},
          "format": "date-time"
{%- elif k == 'interval' %},
          "format": "duration"
{%- elif k == 'decimal' %},
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
{%- endif %}
{%- if field.value.is.primitive and field.value.property.primitive.is.string and field.value.property.primitive.constraints.length is not none and field.value.property.primitive.constraints.length.has_max %},
          "maxLength": {{ field.value.property.primitive.constraints.length.max }}
{%- endif %}
{%- if field.value.is.primitive and field.value.property.primitive.is.string and field.value.property.primitive.constraints.length is not none and field.value.property.primitive.constraints.length.has_min and field.value.property.primitive.constraints.length.min > 0 %},
          "minLength": {{ field.value.property.primitive.constraints.length.min }}
{%- endif %}
{%- if field.value.is.primitive and field.value.property.primitive.is.string and field.value.property.primitive.constraints.length is not none and field.value.property.primitive.constraints.length.has_exact %},
          "minLength": {{ field.value.property.primitive.constraints.length.exact }},
          "maxLength": {{ field.value.property.primitive.constraints.length.exact }}
{%- endif %}
{%- if field.value.is.primitive and field.value.property.primitive.is.string and field.value.property.primitive.constraints.pattern is not none %}{% for expression in field.value.property.primitive.constraints.pattern.match %}{% if loop.first and kind(field) | trim == 'text' %},
          "pattern": {{ expression | tojson }}
{%- endif %}{% endfor %}{%- endif %}

{%- if field.value.is.enum %},
          "enum": [{% for item in field.value.property.enum.values %}{{ item.value_json }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if is_primary(storage, field) | trim %},
          "x-primaryKey": true
{%- endif %}
{%- if managed(field) | trim %},
          "x-managed": true
{%- endif %},
          "x-role": {% if (managed(field) | trim) or (nk.has and (is_primary(storage, field) | trim)) %}"system"{% elif nk.has and field.name.snake == 'code' %}"key"{% elif is_link(field) | trim %}"link"{% else %}"data"{% endif %}
{%- if is_link(field) | trim %},
          "x-link": { "tableId": {{ field.relation.target.schema.id | tojson }}, "column": {{ field.relation.target.field.snake | tojson }}, "alias": {{ alias_of(field) | trim | tojson }} }
{%- endif %}
        }
{%- endif %}{% endfor %}
      }
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
