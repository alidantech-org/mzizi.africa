{#- Everything is derived from the contracts. Column types use a small closed vocabulary that the manifest package maps to checks. -#}
{%- macro table_of(schema) -%}{%- set storage = schema.facets.storage -%}{%- if storage is not none and storage.name is not none -%}{{ storage.name }}{%- else -%}{{ schema.name.snake }}{%- endif -%}{%- endmacro -%}
{%- macro qualified(schema) -%}{{ schema.facets.storage.namespace }}.{{ table_of(schema) }}{%- endmacro -%}
{%- macro kind(field) -%}
{%- set value = field.value -%}
{%- if value.is.primitive -%}
  {%- set primitive = value.property.primitive -%}
  {%- if primitive.is.string and primitive.is.uuid -%}uuid
  {%- elif primitive.is.string -%}text
  {%- elif primitive.is.boolean -%}boolean
  {%- elif primitive.money is not none and primitive.money.minor_units -%}integer
  {%- elif primitive.is.integer -%}integer
  {%- elif primitive.is.decimal -%}decimal
  {%- else -%}number
  {%- endif -%}
{%- elif value.is.enum -%}text
{%- elif value.is.temporal -%}
  {%- set temporal = value.property.temporal -%}
  {%- if temporal.is.date -%}date
  {%- elif temporal.is.time -%}time
  {%- elif temporal.is.duration or temporal.is.interval -%}interval
  {%- else -%}timestamp
  {%- endif -%}
{%- else -%}{{ {}[field.name.raw ~ ': property kind has no column type'] }}
{%- endif -%}
{%- endmacro -%}
{%- macro is_primary(storage, field) -%}
{%- for key in storage.primary_key -%}{%- if key.raw == field.name.raw -%}yes{%- endif -%}{%- endfor -%}
{%- endmacro -%}
{
  "$comment": "Generated by dryv pack mzizi.table-schemas. Do not edit.",
  "group": {{ group.name.kebab | tojson }},
  "tables": [
{%- for schema in schemas %}{% set storage = schema.facets.storage %}
    {
      "id": {{ schema.id | tojson }},
      "table": {{ qualified(schema) | trim | tojson }},
      "namespace": {{ storage.namespace | tojson }},
      "name": {{ table_of(schema) | trim | tojson }},
      "primaryKey": [{% for key in storage.primary_key %}{{ key.snake | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}],
      "columns": [
{%- set first = namespace(value=true) -%}
{%- for field in schema.fields %}{% if field.related is none and field.value is not none and not field.value.is.unknown %}
        {% if not first.value %},{% endif %}{% set first.value = false %}{
          "name": {{ field.name.snake | tojson }},
          "type": {{ kind(field) | trim | tojson }},
          "required": {{ 'false' if (field.optional or field.nullable or (field.default is not none and field.default.kind == 'value')) else 'true' }},
          "nullable": {{ 'true' if (field.optional or field.nullable) else 'false' }},
          "primaryKey": {{ 'true' if is_primary(storage, field) | trim else 'false' }}
{%- if field.default is not none and field.default.kind == 'value' %},
          "default": {{ field.default.value | tojson }}
{%- endif %}
{%- if field.value.is.primitive and field.value.property.primitive.is.string and field.value.property.primitive.constraints.length is not none and field.value.property.primitive.constraints.length.has_max %},
          "maxLength": {{ field.value.property.primitive.constraints.length.max }}
{%- endif %}
{%- if field.value.is.primitive and field.value.property.primitive.is.decimal %},
          "precision": {{ field.value.property.primitive.constraints.precision }},
          "scale": {{ field.value.property.primitive.constraints.scale }}
{%- endif %}
{%- if field.value.is.enum %},
          "enum": [{% for item in field.value.property.enum.values %}{{ item.value_json }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if field.relation is not none and field.relation.enforcement == 'foreign-key' %},
          "references": { "tableId": {{ field.relation.target.schema.id | tojson }}, "column": {{ field.relation.target.field.snake | tojson }} }
{%- endif %}
        }
{%- endif %}{%- endfor %}
      ],
      "uniqueKeys": [
{%- set firstkey = namespace(value=true) -%}
{%- for index in storage.indexes %}{% if index.unique %}
        {% if not firstkey.value %},{% endif %}{% set firstkey.value = false %}[{% for item in index.fields %}{{ item.snake | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}{% endfor %}
      ]
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
