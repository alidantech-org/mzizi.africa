{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schemas/site/v1/manifest.schema.json",
  "title": "mzizi.site/v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "modules", "policy"],
  "properties": {
    "schema": { "const": "mzizi.site/v1" },
    "kind": { "enum": ["site", "family"], "default": "site" },
    "site": { "$ref": "common.schema.json#/$defs/siteCode" },
    "family": { "$ref": "common.schema.json#/$defs/siteCode" },
    "extends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": { "family": { "$ref": "common.schema.json#/$defs/siteCode" }, "version": { "type": "integer", "minimum": 1 } }
    },
    "vars": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }, "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replace": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" } },
            "add": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" } },
            "remove": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" } }
          }
        },
        "tags": { "$ref": "common.schema.json#/$defs/tags" }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_role": { "enum": ["primary", "alias", "mirror"] },
        "paths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/pathPrefix" } }
      }
    },
    "fetch": { "type": "object", "additionalProperties": false, "properties": { "mode": { "enum": ["http", "api", "browser"] } } },
    "modules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/name" }, "uniqueItems": true },
    "tags": { "$ref": "common.schema.json#/$defs/tags" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "rate", "identify", "robots", "auth"],
      "properties": {
        "assessment": { "type": "object", "additionalProperties": false, "required": ["ref"], "properties": { "ref": { "type": "string", "minLength": 1 } } },
        "licence": { "type": "object", "additionalProperties": false, "properties": { "ref": { "type": "string" }, "source": { "type": "string", "format": "uri" } } },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts"],
          "properties": {
            "hosts": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/hostname" } },
            "schemes": { "type": "array", "items": { "enum": ["https", "http"] }, "minItems": 1 },
            "paths": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allow": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/pathPrefix" } },
                "deny": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/pathPrefix" } }
              }
            }
          }
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests_per_second"],
          "properties": {
            "requests_per_second": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
            "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "max": { "type": "integer", "minimum": 0, "maximum": 5 }, "backoff": { "enum": ["exponential_jitter"] } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }, "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 } }
        },
        "identify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_agent"],
          "properties": { "user_agent": { "type": "string", "pattern": "^\\S+/\\S+ \\(\\+https?://\\S+[;,] ?\\S+@\\S+\\)$" } }
        },
        "robots": { "enum": ["respect"] },
        "auth": { "const": "none" },
        "stop_on": { "type": "array", "items": { "enum": ["401", "403", "429", "repeated_5xx", "access_challenge", "block_notice"] }, "uniqueItems": true },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "excluded_categories": { "type": "array", "items": { "type": "string" } },
            "on_unexpected": { "enum": ["quarantine"] }
          }
        },
        "purposes": { "type": "array", "items": { "enum": ["research", "public_atlas", "publish"] } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "family" } }, "required": ["kind"] }, "then": { "required": ["family"], "not": { "required": ["site"] } }, "else": { "required": ["site"] } }
  ]
}
