{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schemas/site/v1/module.schema.json",
  "title": "mzizi.site/v1 module",
  "type": "object",
  "additionalProperties": false,
  "required": ["module", "discover", "extract"],
  "properties": {
    "module": { "$ref": "common.schema.json#/$defs/name" },
    "tags": { "$ref": "common.schema.json#/$defs/tags" },
    "discover": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "listing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "items"],
          "properties": {
            "url": { "type": "string", "pattern": "^(/|\\$\\{)" },
            "items": { "$ref": "common.schema.json#/$defs/selectors" },
            "paginate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "enum": ["query", "path", "next_link", "none"] },
                "param": { "type": "string" },
                "start": { "type": "integer" },
                "max_pages": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "next": { "$ref": "common.schema.json#/$defs/selectors" },
                "stop_when": { "enum": ["empty_items", "no_next", "max_pages"] }
              }
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "items"],
          "properties": {
            "url": { "type": "string", "pattern": "^(/|\\$\\{)" },
            "query": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "items": { "$ref": "common.schema.json#/$defs/selectors" },
            "paginate": { "type": "object", "additionalProperties": true }
          }
        },
        "sitemap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": { "url": { "type": "string", "pattern": "^/" }, "include": { "type": "string" } }
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "resource": { "enum": ["html", "json", "csv", "xlsx", "pdf", "geojson", "shapefile", "xml"] }, "link": { "$ref": "common.schema.json#/$defs/selectors" } }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "oneOf": [{ "type": "string" }, { "$ref": "common.schema.json#/$defs/selectors" }] },
              "regex": { "type": "string" },
              "parse": { "$ref": "common.schema.json#/$defs/transform" },
              "const": { "type": ["string", "number", "boolean"] },
              "tags": { "$ref": "common.schema.json#/$defs/tags" }
            }
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "min_items": { "type": "integer", "minimum": 0 }, "max_items": { "type": "integer", "minimum": 0 }, "required_fields": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
