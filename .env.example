# Copy to .env only when no local .env exists. Never commit real credentials. The engine reads this file once, in
# source/backend/engine/src/mzizi_engine/config/engine_config.py (variables already set in the environment win).

# --- PostgreSQL: the engine writes through DATABASE_WRITE_URL; DATABASE_URL is the read-only role the API uses
DATABASE_URL=postgres://api_reader@localhost:5432/mzizi
DATABASE_WRITE_URL=postgres://mzizi_engine@localhost:5432/mzizi

# --- S3 (SeaweedFS): endpoint, bucket, region and credentials (AWS_* names are accepted)
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ORIGIN=http://127.0.0.1:8333
S3_BUCKET=replace-with-bucket
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace

# --- filesystem rules (comma lists; "-" means none)
FILESYSTEM_PROTECTED_PREFIXES=-
FILESYSTEM_RESERVED_ROOTS=-
FILESYSTEM_TEMP_PREFIX=private/tmp/

# --- MongoDB (staging and the activity store); ENGINE_ACTIVITY_STORE=files turns the activity store off
MZIZI_MONGO_URL=mongodb://127.0.0.1:27017
MZIZI_MONGO_DATABASE=mzizi

# --- vector store (a skeleton; optional)
# MZIZI_VECTOR_URL=http://127.0.0.1:6333

# --- crawling identity and local inputs
MZIZI_USER_AGENT=Name/1.0 (+https://your.site/bot; you@your.site)
# ENGINE_INPUT_ROOT=/path/files/may/be/read/from
# MZIZI_DEV_ROOT=/path/to/.dev
# MZIZI_MARKDOWN_WORKERS=4
# MZIZI_MIN_FREE_GB=8
# MZIZI_DEBUG_STACKS=60
# MZIZI_WEB_VOCABULARY=/path/to/vocabulary.yml

# --- Spec-driven runs (phase 1 supports local storage)
ENGINE_RUN_STORE=local
# ENGINE_RUN_LOCAL_ROOT=/path/to/.dev/runs
# Set the Mongo event retention in days before running a spec.
# ENGINE_RUN_LOG_RETENTION_DAYS=
# Settings reserved for later phases.
# ENGINE_RUN_SCRATCH_ROOT=/path/to/scratch
# ENGINE_RUN_RETENTION_DAYS=
# ENGINE_WORKER_CEILING=1

# --- the engine's HTTP front door
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8760
ENGINE_AUTH=oidc
AUTH_ISSUER=
ENGINE_SERVICE_TOKEN=replace-with-a-local-random-token

# --- search providers (each optional)
# BRAVE_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
