# Copy this file to .env only when no local .env exists. Never commit real credentials.
# Administrative URL is used by the TypeScript database CLI only.
MZIZI_DATABASE_URL=postgres://postgres@localhost:5432/mzizi_new
# Runtime database service URL is restricted to named-operation grants.
DATABASE_RUNTIME_URL=postgres://database_runtime@localhost:5432/mzizi_new
# NestJS product API read-only URL.
DATABASE_URL=postgres://api_reader@localhost:5432/mzizi_new
DATABASE_PORT=3301
DATABASE_SERVICE_URL=http://127.0.0.1:3301
DATABASE_SERVICE_TOKEN=replace-with-a-local-random-token
# Enables unauthenticated local engine operations only; the Bun service remains loopback-bound.
DATABASE_OPERATOR_MODE=1
PIPELINES_PORT=3302
PIPELINES_API_TOKEN=replace-with-another-local-random-token
TEMPORAL_ADDRESS=127.0.0.1:7233
ENGINE_URL=http://127.0.0.1:8760
ENGINE_SERVICE_TOKEN=replace-with-a-local-random-token
ENGINE_STORE=database_service
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8760
