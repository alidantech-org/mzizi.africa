{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["package.json", "biome.json", "tsconfig.json", "scripts/**", "dryv/tools/**", "dryv/contracts/**", "dryv/package.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 145 },
  "linter": { "rules": { "recommended": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
