{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schemas/site/v1/ranking.schema.json",
  "title": "mzizi.ranking/v1 rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "mzizi.ranking/v1"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "label",
          "conditions"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence_cap": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "provenance": {
            "enum": [
              "custom-prepared",
              "discovered",
              "ai-proposed",
              "reviewed"
            ]
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "signal",
                "contains"
              ],
              "properties": {
                "signal": {
                  "enum": [
                    "section",
                    "anchor_text",
                    "filename",
                    "source_page_title",
                    "source_page_path",
                    "extension"
                  ]
                },
                "contains": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              }
            }
          }
        }
      }
    }
  }
}
