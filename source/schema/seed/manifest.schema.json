{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schemas/seed/manifest.schema.json",
  "title": "Seed manifest (seed/manifest.yaml)",
  "description": "The one authored manifest of the seed tree. It registers files and their versioning; it never loads data. A CSV's table comes from its path (data/<scope>/<domain>/<table>.csv), a source's identity from its code. Per-folder facts live in _folder.yaml; hashes and object keys are generated into manifest.lock.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "bucket",
    "region",
    "logical_root",
    "root_code",
    "entries"
  ],
  "properties": {
    "release": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "bucket": {
      "const": "mzizi"
    },
    "region": {
      "const": "us-east-1"
    },
    "logical_root": {
      "type": "string",
      "pattern": "^/[a-z0-9][a-z0-9_-]*$",
      "not": {
        "enum": [
          "/raw",
          "/tmp",
          "/content"
        ]
      }
    },
    "root_code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versioning": {
          "enum": [
            "versioned",
            "current"
          ],
          "description": "versioned keeps earlier revisions of changed bytes; current replaces the readable key and keeps no history."
        },
        "pin": {
          "type": "boolean"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "glob"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[^/].*$"
        },
        "glob": {
          "type": "string",
          "pattern": "^[^/].*$"
        },
        "media_type": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Entry ids that must be registered and imported first."
        },
        "origin": {
          "type": [
            "string",
            "object"
          ],
          "description": "Where the content came from: one note, or a note per file path."
        },
        "notes": {
          "type": "string"
        },
        "versioning": {
          "enum": [
            "versioned",
            "current"
          ],
          "description": "versioned keeps earlier revisions of changed bytes; current replaces the readable key and keeps no history."
        },
        "pin": {
          "type": "boolean",
          "description": "Pin every registered revision to this release (never pruned). Defaults to true for versioned entries."
        }
      }
    }
  }
}
