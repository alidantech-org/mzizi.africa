{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.alidantech.org/mzizi/public/schemas/seed/folder.schema.json",
  "title": "Folder descriptor (_folder.yaml)",
  "description": "Facts about a folder that its children inherit. scope and domain are read from the path (data/ke/geography), so a descriptor states them only where the path cannot.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "global",
            "system",
            "jurisdiction"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "jurisdiction"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "code"
        ]
      }
    },
    "role": {
      "enum": [
        "test_fixture",
        "seed_input",
        "pattern_definition",
        "site_structure",
        "import_mapping",
        "policy_definition",
        "pipeline_manifest",
        "research_registry",
        "generated_output",
        "evidence",
        "backup",
        "report",
        "log",
        "certificate",
        "object_store"
      ]
    },
    "acquisition_class": {
      "enum": [
        "static_curated",
        "pattern_generated",
        "externally_collected",
        "internally_derived"
      ]
    },
    "preparation": {
      "enum": [
        "human_prepared",
        "ai_prepared",
        "human_and_ai_assisted",
        "programmatically_generated",
        "unknown"
      ]
    },
    "access": {
      "enum": [
        "public",
        "internal",
        "restricted",
        "private"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "needs_review",
            "proposed"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "seed": {
      "type": "boolean"
    },
    "allow_weaker_children": {
      "type": "boolean"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "date",
        "reference"
      ],
      "description": "Required when access is public.",
      "properties": {
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "test_fixture",
              "seed_input",
              "pattern_definition",
              "site_structure",
              "import_mapping",
              "policy_definition",
              "pipeline_manifest",
              "research_registry",
              "generated_output",
              "evidence",
              "backup",
              "report",
              "log",
              "certificate",
              "object_store"
            ]
          },
          "access": {
            "enum": [
              "public",
              "internal",
              "restricted",
              "private"
            ]
          },
          "review": {
            "type": "object"
          },
          "preparation": {
            "type": "string"
          },
          "acquisition_class": {
            "type": "string"
          }
        }
      },
      "description": "Per-child exceptions, keyed by file or folder name, each with a reason."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "access": {
            "const": "public"
          }
        },
        "required": [
          "access"
        ]
      },
      "then": {
        "required": [
          "authorization"
        ]
      }
    }
  ]
}
