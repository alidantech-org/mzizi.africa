{
  "$schema": "https://res.alidantech.org/mzizi/public/schemas/engine/job.schema.json",
  "code": "sys.eng.job.ke.example-ministry-publications",
  "spec_version": 1,
  "kind": "collection",
  "name": "example-ministry-publications",
  "sources": [
    {
      "url": "https://www.example.org/publications/",
      "authority_ref": "pg.src.srs.ke.example-ministry"
    }
  ],
  "mode": "crawl",
  "limits": {
    "max_requests": 200,
    "max_seconds": 600
  },
  "stages": [
    {
      "operation": "scraping.crawl",
      "params": {
        "url": "https://www.example.org/publications/",
        "out_dir": "./output"
      }
    }
  ]
}
