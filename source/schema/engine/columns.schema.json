{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.alidantech.org/mzizi/public/schemas/engine/columns.schema.json",
  "title": "Column dictionary",
  "description": "Which term groups, patterns and heading rules define each database column, how a table's code is built, and where the known names of a table's rows come from. A dictionary is `sys.col.<scope>.<domain>` at `seed/columns/<scope>/<domain>.yml`. Columns are seed columns: a link is its `_code` column, never an id. Terms stay neutral and never name a table; the dictionary is where words meet columns. A mapping can add or override links for one source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "columns"
  ],
  "properties": {
    "code": {
      "$ref": "../sources/common.schema.json#/$defs/code"
    },
    "describe": {
      "type": "string"
    },
    "columns": {
      "type": "object",
      "minProperties": 1,
      "description": "Keyed by <schema>.<table>.<column>, the stored column name; the manifest checker verifies each against the database schema.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "means": {
            "type": "string",
            "description": "What the column holds, in plain words."
          },
          "shape": {
            "enum": [
              "text",
              "name",
              "money",
              "date",
              "integer",
              "code",
              "percentage",
              "url",
              "email",
              "phone"
            ],
            "description": "What its cells look like."
          },
          "says": {
            "type": "string",
            "description": "What a match tells the engine about the row, for example person or organisation."
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "list",
                "key",
                "role"
              ],
              "properties": {
                "list": {
                  "$ref": "../sources/common.schema.json#/$defs/code"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "description": "A group, pattern or heading rule of the list or of a list it extends."
                },
                "role": {
                  "enum": [
                    "heading",
                    "value",
                    "unit",
                    "member",
                    "exclude"
                  ],
                  "description": "heading: words in a column heading. value: words or a pattern in the cells. unit: a currency or scale in the heading or cell. member: words that stand for a reference value. exclude: words that rule this column out."
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 5,
                  "default": 1
                },
                "says": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "description": "Per table: how its code is proposed. A generated code is a proposal: it is checked for uniqueness against known codes and a person approves new ones.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "describe": {
            "type": "string"
          },
          "code": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "minItems": 1,
                "description": "Segments joined by a dot, in order.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scope": {
                      "type": "boolean",
                      "description": "The country scope of the source (ke), or global."
                    },
                    "const": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "slug": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "The mapped value of this seed column, as a lowercase dashed slug (Kiambu County becomes kiambu-county)."
                    },
                    "name_slug": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "Like slug, but words that only say what kind of thing it is (county, town, limited) are dropped, and the kind is added when `kind` is set."
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "The code already built or found for this link column, in full."
                    },
                    "last": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "The last segment of the code for this link column."
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "The raw mapped value of this column, slugged (a bid number, a year)."
                    },
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "A kind link whose last segment qualifies the code (county, town) when two things share a name."
                    },
                    "optional": {
                      "type": "boolean",
                      "default": false
                    },
                    "input": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "description": "A named value the run supplies or a source column provides (a tender reference, a bid number), declared under `inputs` or given with the run."
                    },
                    "qualifier": {
                      "type": "string",
                      "description": "A seed column (<schema>.<table>.<column>) or `input:<name>` whose slug is added to the previous segment after a tilde (`rawel-holdings~107`)."
                    }
                  }
                }
              },
              "unique_within": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                  "description": "A seed column as <schema>.<table>.<column>."
                },
                "description": "Seed columns that, with the parts, make the code unique when two rows would otherwise collide."
              }
            }
          },
          "lookup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sources"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "table",
                    "text",
                    "code"
                  ],
                  "properties": {
                    "table": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                      "description": "The table whose rows hold names for this table's records."
                    },
                    "text": {
                      "type": "string",
                      "description": "The seed column holding the name text."
                    },
                    "code": {
                      "type": "string",
                      "description": "The seed column holding the code of the record the name belongs to."
                    },
                    "language": {
                      "type": "string",
                      "description": "The seed column holding the language code, if any."
                    },
                    "kind": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "table",
                        "key",
                        "column"
                      ],
                      "properties": {
                        "table": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "column": {
                          "type": "string"
                        }
                      },
                      "description": "Where the record's kind comes from: the row of `table` whose `key` column equals the code, and its `column` value."
                    }
                  }
                }
              }
            }
          },
          "inputs": {
            "type": "object",
            "description": "Named values a source column can supply to this table's code or rows: each name lists the heading words that carry it.",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "list",
                  "key"
                ],
                "properties": {
                  "list": {
                    "$ref": "../sources/common.schema.json#/$defs/code"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
