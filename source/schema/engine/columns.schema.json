{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.alidantech.org/mzizi/public/schemas/engine/columns.schema.json",
  "title": "Column dictionary",
  "description": "Which term groups, patterns and heading rules define each database column, by term list code and key. A dictionary is `sys.col.<scope>.<domain>` at `seed/columns/<scope>/<domain>.yml`. Terms stay neutral and never name a table; the dictionary is where words meet columns. A mapping can add or override links for one source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "columns"
  ],
  "properties": {
    "code": {
      "$ref": "../sources/common.schema.json#/$defs/code"
    },
    "describe": {
      "type": "string"
    },
    "columns": {
      "type": "object",
      "minProperties": 1,
      "description": "Keyed by <schema>.<table>.<column>, the stored column name; the manifest checker verifies each against the database schema.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "means": {
            "type": "string",
            "description": "What the column holds, in plain words."
          },
          "shape": {
            "enum": [
              "text",
              "name",
              "money",
              "date",
              "integer",
              "code",
              "percentage",
              "url",
              "email",
              "phone"
            ],
            "description": "What its cells look like."
          },
          "says": {
            "type": "string",
            "description": "What a match tells the engine about the row, for example person or organisation."
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "list",
                "key",
                "role"
              ],
              "properties": {
                "list": {
                  "$ref": "../sources/common.schema.json#/$defs/code"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "description": "A group, pattern or heading rule of the list or of a list it extends."
                },
                "role": {
                  "enum": [
                    "heading",
                    "value",
                    "unit",
                    "member",
                    "exclude"
                  ],
                  "description": "heading: words in a column heading. value: words or a pattern in the cells. unit: a currency or scale in the heading or cell. member: words that stand for a reference value. exclude: words that rule this column out."
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 5,
                  "default": 1
                },
                "says": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
