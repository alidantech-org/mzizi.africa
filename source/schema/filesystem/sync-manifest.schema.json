{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schemas/filesystem/sync-manifest",
  "title": "Filesystem sync manifest",
  "description": "Selects local trees or files under the seed root for registration. Only named fields and glob patterns: no expressions, commands or code. Identity is the registry code, not the local path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "root", "logical_root", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "filesystem-sync"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "release": {"type": "string"},
    "root": {"type": "string", "description": "Directory relative to the seed root; never absolute and never containing .."},
    "logical_root": {"type": "string", "pattern": "^/[^/]+(/[^/]+)*$"},
    "defaults": {"type": "object", "additionalProperties": false, "properties": {"retention": {"enum": ["preserve_history", "replace_current"]}}},
    "folders": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "pattern": "^/[^/]+(/[^/]+)*$"}, "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)*$", "maxLength": 255}, "description": {"type": "string"}, "classification": {"$ref": "#/$defs/classification"}}}},
    "entries": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "source": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {
          "path": {"type": "string", "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
          "include": {"type": "array", "items": {"type": "string"}},
          "exclude": {"type": "array", "items": {"type": "string"}}}},
        "folder": {"type": "string", "pattern": "^/[^/]+(/[^/]+)*$"},
        "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)*$", "maxLength": 255, "description": "Explicit hierarchical code for the entry folder (.docs/rules/code-columns.md); normally omitted so it derives from the parent code."},
        "identities": {"type": "object", "description": "Stable registry codes for specific relative paths, so a local rename keeps its logical file.", "additionalProperties": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)*$", "maxLength": 255}},
        "allow_sensitive": {"type": "boolean", "description": "Permit credential-like files (keys, env files). Honoured only when the entry classification access is private."},
        "flatten": {"type": "boolean", "description": "Register every selected file directly in the entry folder (names must be unique)."},
        "retention": {"enum": ["preserve_history", "replace_current"]},
        "pin_reason": {"type": "string"},
        "description": {"type": "string"},
        "note": {"type": "string"},
        "classification": {"$ref": "#/$defs/classification"}}}}
  },
  "$defs": {
    "classification": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "access": {"enum": ["public", "internal", "restricted", "private"]},
        "access_authorization": {"type": "object", "required": ["by", "date", "reference"]},
        "allow_weaker_children": {"type": "boolean"},
        "artifact_role": {"enum": ["test_fixture", "seed_input", "pattern_definition", "site_structure", "import_mapping", "policy_definition", "research_registry", "generated_output", "evidence", "backup", "report", "log", "certificate", "object_store"]},
        "is_seed": {"type": "boolean"},
        "acquisition_class": {"enum": ["static_curated", "pattern_generated", "externally_collected", "internally_derived"]},
        "preparation": {"enum": ["human_prepared", "ai_prepared", "human_and_ai_assisted", "programmatically_generated", "unknown"]},
        "jurisdiction_code": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "scope": {"type": "object"},
        "review": {"type": "object", "required": ["status", "note"], "properties": {"status": {"enum": ["reviewed", "needs_review"]}, "note": {"type": "string"}}},
        "origin_note": {"type": "string"}}}
  }
}
