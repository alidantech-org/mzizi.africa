{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schema/pipeline/v1/manifest.schema.json",
  "title": "Mzizi pipeline manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "steps"],
  "properties": {
    "schema_version": { "const": "pipeline/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,99}$" },
    "version": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "capability", "capability_version", "input"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "capability": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,99}$" },
          "capability_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "maxItems": 20 },
          "input": { "type": "object" },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
          "review_gate": { "type": "boolean" }
        }
      }
    }
  }
}
