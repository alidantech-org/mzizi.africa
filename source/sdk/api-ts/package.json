{
  "name": "@mzizi/api-client",
  "private": true,
  "type": "module",
  "description": "Mzizi API client: Next.js server actions, route maps and types generated by Dryv from the API contract.",
  "imports": {
    "#sdk/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions/index.ts",
    "./actions/*": "./src/actions/*.actions.ts",
    "./routes": "./src/routes.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "next-api-bridge": "^0.1.10",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "next": "latest",
    "react": "latest",
    "typescript": "latest"
  }
}