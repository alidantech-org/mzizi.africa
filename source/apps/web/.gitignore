node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Local content and demonstration datasets. Keep source code separate from data.
/src/app/demo/_data/*
!/src/app/demo/_data/*.d.ts
/src/app/demo/_scripts/geo-input/
/src/app/demo/_scripts/inputs/
/src/app/demo/_scripts/build-data.ts
**/*.geojson
**/*.geojson.*
**/*.topojson
**/*.topojson.*
**/fixtures/
**/seed/

# Historical local code is not part of the active UI checkpoint.
/src/app/demo/_archives/

# Downloaded media and flags stay local. Only app identity assets are tracked.
/public/*
!/public/sw.js
!/public/icons/
/public/icons/*
!/public/icons/icon-192.png
!/public/icons/icon-512.png
!/public/icons/maskable-512.png

# Content images elsewhere in the app are excluded; app identity is explicit.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
*.ico
!/public/icons/icon-192.png
!/public/icons/icon-512.png
!/public/icons/maskable-512.png

# Static app identity assets referenced by document metadata and the manifest.
!/public/icons/icon.svg
!/public/icons/favicon.ico
!/public/icons/apple-icon.png

# Demo downloads stay local; only its worker and offline-page source are tracked.
/src/app/demo/_assets/*
!/src/app/demo/_assets/sw.js
!/src/app/demo/_assets/offline.html
