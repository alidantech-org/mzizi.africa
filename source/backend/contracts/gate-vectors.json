{
  "note": "Shared test vectors for the collection gate. Both implementations (engine/database/src/gate.ts and engine/data/src/mzizi_data/gate.py) must produce the same allowed/denied answer and a reason containing the given text. Overrides are merged over the base records; an assessment of null means no assessment exists.",
  "now": "2026-11-02T10:00:00Z",
  "base": {
    "assessment": {
      "id": "a1",
      "status": "approved",
      "jurisdictionId": "j-ke",
      "personalDataCategories": "[\"none_known\"]",
      "lawfulBasis": null,
      "approvedScope": "{\"hosts\":[\"treasury.go.ke\"],\"schemes\":[\"https\"],\"paths\":{\"allow\":[\"/publications/\"],\"deny\":[\"/publications/internal/\"]},\"fetchModes\":[\"http\"],\"maxRequestsPerSecond\":0.5,\"purposes\":[\"collect\",\"publish\"]}",
      "conditions": null,
      "reviewedBy": "reviewer-1",
      "reviewedAt": "2026-10-01T00:00:00Z",
      "reviewDueAt": "2027-10-01T00:00:00Z"
    },
    "dossierStage": "pilot",
    "request": { "siteId": "s1", "host": "treasury.go.ke", "scheme": "https", "path": "/publications/budget.pdf", "method": "GET", "fetchMode": "http", "purpose": "collect", "requestsPerSecond": 0.4 }
  },
  "vectors": [
    { "name": "approved request inside scope", "expect": { "allowed": true, "requestsPerSecond": 0.5 } },
    { "name": "no assessment, collect", "assessment": null, "expect": { "allowed": false, "reason": "legal status is not_reviewed" } },
    { "name": "no assessment, assess", "assessment": null, "request": { "purpose": "assess" }, "expect": { "allowed": true } },
    { "name": "not_reviewed, collect", "assessment": { "status": "not_reviewed" }, "expect": { "allowed": false, "reason": "not_reviewed" } },
    { "name": "in_review, assess is limited to a low rate", "assessment": { "status": "in_review" }, "request": { "purpose": "assess", "requestsPerSecond": 5 }, "expect": { "allowed": true, "requestsPerSecond": 0.5 } },
    { "name": "assess with POST", "request": { "purpose": "assess", "method": "POST" }, "expect": { "allowed": false, "reason": "GET and HEAD" } },
    { "name": "restricted, assess", "assessment": { "status": "restricted" }, "request": { "purpose": "assess" }, "expect": { "allowed": false, "reason": "restricted" } },
    { "name": "rejected, collect", "assessment": { "status": "rejected" }, "expect": { "allowed": false, "reason": "rejected" } },
    { "name": "expired, collect", "assessment": { "status": "expired" }, "expect": { "allowed": false, "reason": "expired" } },
    { "name": "expired, assess", "assessment": { "status": "expired" }, "request": { "purpose": "assess" }, "expect": { "allowed": true } },
    { "name": "overdue review is treated as expired", "assessment": { "reviewDueAt": "2026-10-31T00:00:00Z" }, "expect": { "allowed": false, "reason": "overdue" } },
    { "name": "approval without a named reviewer", "assessment": { "reviewedBy": null }, "expect": { "allowed": false, "reason": "accountable human reviewer" } },
    { "name": "other host", "request": { "host": "other.go.ke" }, "expect": { "allowed": false, "reason": "outside the approved scope" } },
    { "name": "denied path", "request": { "path": "/publications/internal/x.pdf" }, "expect": { "allowed": false, "reason": "is denied" } },
    { "name": "path outside allow list", "request": { "path": "/admin/" }, "expect": { "allowed": false, "reason": "not in the allowed paths" } },
    { "name": "http scheme", "request": { "scheme": "http" }, "expect": { "allowed": false, "reason": "scheme" } },
    { "name": "browser fetch mode", "request": { "fetchMode": "browser" }, "expect": { "allowed": false, "reason": "fetch mode" } },
    { "name": "request rate above the limit", "request": { "requestsPerSecond": 2 }, "expect": { "allowed": false, "reason": "exceeds the limit" } },
    { "name": "unparseable scope", "assessment": { "approvedScope": "{oops" }, "expect": { "allowed": false, "reason": "not valid JSON" } },
    { "name": "no jurisdiction", "assessment": { "jurisdictionId": null }, "expect": { "allowed": false, "reason": "no jurisdiction" } },
    { "name": "dossier missing", "dossierStage": null, "expect": { "allowed": false, "reason": "dossier" } },
    { "name": "dossier at research", "dossierStage": "research", "expect": { "allowed": false, "reason": "dossier" } },
    { "name": "dossier at production", "dossierStage": "production", "expect": { "allowed": true } },
    { "name": "personal data without a lawful basis", "assessment": { "personalDataCategories": "[\"office_holder_names\"]" }, "expect": { "allowed": false, "reason": "lawful basis" } },
    { "name": "personal data with a lawful basis", "assessment": { "personalDataCategories": "[\"office_holder_names\"]", "lawfulBasis": "public task, documented" }, "expect": { "allowed": true } },
    { "name": "condition tightens the rate", "assessment": { "status": "approved_with_conditions", "conditions": "[{\"type\":\"max_requests_per_second\",\"value\":0.1}]" }, "request": { "requestsPerSecond": 0.1 }, "expect": { "allowed": true, "requestsPerSecond": 0.1 } },
    { "name": "condition rate exceeded", "assessment": { "status": "approved_with_conditions", "conditions": "[{\"type\":\"max_requests_per_second\",\"value\":0.1}]" }, "request": { "requestsPerSecond": 0.4 }, "expect": { "allowed": false, "reason": "exceeds the limit" } },
    { "name": "no_publish condition blocks publish", "assessment": { "status": "approved_with_conditions", "conditions": "[{\"type\":\"no_publish\"}]" }, "request": { "purpose": "publish" }, "expect": { "allowed": false, "reason": "forbids publication" } },
    { "name": "no_publish condition allows collect", "assessment": { "status": "approved_with_conditions", "conditions": "[{\"type\":\"no_publish\"}]" }, "expect": { "allowed": true } },
    { "name": "excluded path condition", "assessment": { "status": "approved_with_conditions", "conditions": "[{\"type\":\"excluded_paths\",\"value\":[\"/publications/draft/\"]}]" }, "request": { "path": "/publications/draft/a.pdf" }, "expect": { "allowed": false, "reason": "excluded by a condition" } },
    { "name": "unenforceable condition", "assessment": { "status": "approved_with_conditions", "conditions": "[{\"type\":\"notify_regulator_monthly\"}]" }, "expect": { "allowed": false, "reason": "cannot be enforced" } },
    { "name": "conditions status without conditions", "assessment": { "status": "approved_with_conditions", "conditions": "[]" }, "expect": { "allowed": false, "reason": "none are recorded" } }
  ]
}
