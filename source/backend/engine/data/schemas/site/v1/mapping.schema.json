{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mzizi.africa/schemas/site/v1/mapping.schema.json",
  "title": "mzizi.site/v1 mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping", "module", "target_kind", "key", "fields", "provenance"],
  "properties": {
    "mapping": { "$ref": "common.schema.json#/$defs/name" },
    "module": { "$ref": "common.schema.json#/$defs/name" },
    "target_kind": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
    "key": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "const": { "type": ["string", "number", "boolean"] },
          "transform": { "$ref": "common.schema.json#/$defs/transform" },
          "precision": { "enum": ["exact", "month", "year", "decade", "century", "approximate"] }
        },
        "oneOf": [{ "required": ["from"] }, { "required": ["const"] }]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "method"],
      "properties": {
        "locator": { "type": "object", "additionalProperties": { "type": "string" } },
        "method": { "enum": ["extracted", "inferred", "curated", "ai_assisted"] }
      }
    },
    "tags": { "$ref": "common.schema.json#/$defs/tags" }
  }
}
