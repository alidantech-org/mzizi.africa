PORT=3000
# Optional comma-separated browser origins. Development defaults allow localhost origins.
# Set explicit production origins, for example: https://mzizi.africa,https://app.mzizi.africa
CORS_ORIGINS=
# Read-only role: SELECT on domain tables. Every read uses it.
DATABASE_URL=postgres://mzizi_api_reader:change-me@localhost:5432/mzizi
# Restricted writer: SELECT, INSERT on audit.comments, audit.evidence and audit.decisions only.
DATABASE_WRITE_URL=postgres://mzizi_api_writer:change-me@localhost:5432/mzizi
# Bearer token verification (OIDC-compatible issuer; see .docs/decisions/api-auth-rbac.md).
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# Alternative to AUTH_JWKS_URL for local development: a PEM public key (SPKI).
AUTH_PUBLIC_KEY=
