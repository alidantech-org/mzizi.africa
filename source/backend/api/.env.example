PORT=3000
# Read-only role: SELECT on domain tables only. Used for every domain read.
DATABASE_READ_URL=postgres://mzizi_api_reader:change-me@localhost:5432/mzizi
# Restricted writer: INSERT on comments, evidence and review decision tables only.
DATABASE_WRITE_URL=postgres://mzizi_api_writer:change-me@localhost:5432/mzizi
# OIDC-compatible issuer used to validate bearer tokens (see .docs/decisions/api-auth-rbac.md).
AUTH_ISSUER=
