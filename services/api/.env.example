# Production Environment Variables
# Copy this file to .env and update the values

# Database - Connect to your existing server database
# Your server database connections:
DATABASE_URL=postgresql://admin:strongpassword@192.168.100.13:5432/polifin

# MongoDB (if needed for any features):
MONGODB_URL=mongodb://admin:strongpassword@192.168.100.13:27017

# S3 Storage
S3_ENDPOINT=http://192.168.100.13:9001
S3_ACCESS_KEY=Alidantech
S3_SECRET_KEY=Alidantech#123
S3_FILES_BUCKET=polifin
S3_PUBLIC_URL_BASE=https://assets.alidantech.org

# Redis connection:
REDIS_URL=redis://192.168.100.13:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Security
SECRET_KEY=your_very_secure_secret_key_change_me_in_production_at_least_32_chars
JWT_SECRET_KEY=your_jwt_secret_key_change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/

# CORS (update with your frontend domains)
ALLOWED_ORIGINS=https://prfi.alidantech.org,polifin.alidantech.org

# File Upload
MAX_FILE_SIZE=100MB

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=your_sentry_dsn_if_using

# Email (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
